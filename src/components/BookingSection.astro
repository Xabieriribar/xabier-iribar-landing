---
import { site } from "@utils/seo";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const HeadingTag = compact ? "h1" : "h2";
---

<section
  id="reservation"
  class="booking-section"
  aria-labelledby="booking-title"
>
  <div class="container-shell booking-panel" data-reveal>
    <div class="booking-copy">
      <p class="section-kicker">Réservation</p>
      <HeadingTag id="booking-title" class="section-title">
        Demander mon diagnostic gratuit.
      </HeadingTag>
      <p class="section-copy">
        Choisissez un créneau pour parler d’un processus réel: demandes clients,
        emails, WhatsApp, Excel, devis, relances ou dossiers.
      </p>

      <ul class="booking-list">
        <li>30–45 minutes</li>
        <li>Visio ou téléphone, selon préférence</li>
        <li>Une première piste concrète à la fin de l’échange</li>
        <li>Sans engagement</li>
      </ul>
    </div>

    <aside class="booking-card" aria-label="Choisir un créneau">
      <p class="mini-kicker">Diagnostic gratuit</p>
      <h3>Vous choisissez l’heure. L’événement arrive dans mon calendrier.</h3>
      <p>
        La réservation est gérée par {site.bookingProvider}. Les informations
        servent uniquement à organiser l’échange.
      </p>
      <a
        href={site.bookingHref}
        class="btn-primary"
        target={site.bookingIsConfigured ? "_blank" : undefined}
        rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
      >
        Choisir un créneau
        <span aria-hidden="true">→</span>
      </a>
      {
        !site.bookingIsConfigured && (
          <p class="booking-fallback-note">
            Lien de réservation à configurer. En attendant, ce bouton redirige
            vers le formulaire de contact.
          </p>
        )
      }
      {
        !compact && (
          <p class="booking-alt">
            Vous préférez écrire d’abord ?{" "}
            <a href="#contact">Expliquez votre situation par message</a>.
          </p>
        )
      }
    </aside>
  </div>
</section>
