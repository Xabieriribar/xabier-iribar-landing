---
import { business } from "@config/business";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="footer-brand">{business.identity.name}</p>
      <p>{business.identity.brandLine}</p>
      <p>{business.location.base} · {business.location.serviceArea}</p>
    </div>
    <nav aria-label="Liens de pied de page">
      <a href="/offres/">Offres</a>
      <a href="/audit/">Diagnostic</a>
      <a href="/mentions-legales/">Mentions légales</a>
      <a href="/confidentialite/">Confidentialité</a>
    </nav>
    <div class="footer-contact">
      {
        business.contact.phoneHref && (
          <a href={business.contact.phoneHref}>
            {business.contact.phone.value}
          </a>
        )
      }
      {
        business.contact.emailHref && (
          <a href={business.contact.emailHref}>
            {business.contact.email.value}
          </a>
        )
      }
      <a
        href={business.socials.linkedin}
        rel="me noopener noreferrer"
        target="_blank">LinkedIn</a
      >
    </div>
  </div>
  <div class="shell footer-bottom">
    <small
      >© {new Date().getFullYear()} Xabier Iribar. Site statique, sans cookie publicitaire.</small
    >
  </div>
</footer>
