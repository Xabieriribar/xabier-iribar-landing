---
const faqs = [
  {
    question: "Est-ce que vous vendez un logiciel ?",
    answer:
      "Non. Je commence par une tâche répétitive réelle, puis je propose une amélioration ciblée. L’objectif n’est pas de vous imposer un outil."
  },
  {
    question: "Est-ce que je dois changer mes outils ?",
    answer:
      "Pas forcément. L’objectif est de travailler avec vos outils actuels quand c’est possible."
  },
  {
    question: "Est-ce que l’IA envoie des messages automatiquement ?",
    answer:
      "Non. Les réponses, relances ou actions importantes restent validées par un humain."
  },
  {
    question: "Est-ce que le diagnostic est gratuit ?",
    answer:
      "Oui. Le premier diagnostic terrain sert à comprendre si une tâche mérite d’être simplifiée."
  },
  {
    question: "Est-ce adapté à une petite PME ?",
    answer:
      "Oui. L’approche est pensée pour les petites structures locales, pas pour de grands projets informatiques."
  },
  {
    question: "Est-ce que je peux utiliser des exemples anonymisés ?",
    answer: "Oui. On peut travailler avec des exemples fictifs ou anonymisés."
  }
];
---

<section class="section-pad bg-paper" aria-labelledby="faq-title">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="eyebrow"><span class="red-dot" aria-hidden="true"></span> Questions</p>
      <h2 id="faq-title" class="section-title mt-4">FAQ</h2>
    </div>

    <div class="mt-10 divide-y divide-line rounded-lg border border-line bg-bone">
      {
        faqs.map((faq) => (
          <details class="group p-5 open:bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-lg font-black text-ink">
              {faq.question}
              <span class="plus-mark relative size-6 shrink-0 text-swiss-red transition group-open:rotate-45" aria-hidden="true"></span>
            </summary>
            <p class="mt-4 max-w-3xl leading-7 text-coal/75">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
