---
import { site } from "@utils/seo";
---

<section class="hero-section" data-reveal-scope>
  <div class="container-shell hero-centered">
    <h1 class="hero-title" data-reveal>
      Libérez votre PME de la paperasse. Gardez vos outils actuels.
    </h1>

    <div class="hero-actions" data-reveal>
      <a
        href="#contact"
        class="btn-primary hero-cta"
      >
        Demander mon diagnostic terrain (30 min, gratuit)
        <span aria-hidden="true">→</span>
      </a>
      <a href="#exemples" class="btn-secondary hero-secondary">
        Voir des cas terrain
      </a>
    </div>

    <ul class="hero-bullets" data-reveal>
      <li>Réponses rapides</li>
      <li>Diagnostic terrain gratuit</li>
      <li>Prenez rendez-vous</li>
    </ul>
  </div>
</section>
