---
import { site } from "@utils/seo";
---

<section class="hero-section" data-reveal-scope>
  <div class="container-shell hero-grid">
    <div class="hero-copy">
      <p class="location-line" data-reveal>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
        >
          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        Vaud · Lausanne · Aclens · Suisse romande
      </p>

      <h1 class="hero-title" data-reveal>
        Moins de copier-coller entre vos emails, WhatsApp et Excel.
      </h1>

      <p class="section-copy" data-reveal>
        J’aide les PME vaudoises, artisans et garages à transformer leurs
        demandes, photos, devis et suivis en processus simples et automatisés,
        sans changer tous vos outils.
      </p>

      <p class="terrain-line" data-reveal>
        Je pars du terrain, pas de la technologie.
      </p>

      <div class="hero-actions" data-reveal>
        <a href="#contact" class="btn-primary hero-cta">
          Demander un diagnostic gratuit
          <span aria-hidden="true">→</span>
        </a>
        <a href="#exemples" class="btn-secondary hero-secondary">
          Voir des cas terrain
        </a>
      </div>

      <ul class="hero-proof-list" data-reveal>
        <li>Artisans & garages</li>
        <li>Diagnostic terrain gratuit</li>
        <li>Prototype ciblé en ~7 jours</li>
      </ul>
    </div>

    <aside
      class="portrait-wrap hero-side"
      aria-label="Approche terrain"
      data-reveal
    >
      <figure class="portrait-card" aria-label="Portrait de Xabier Iribar">
        <img
          src="/assets/xabier-iribar-portrait.png"
          alt="Portrait de Xabier Iribar"
          width="1254"
          height="1254"
          loading="eager"
          decoding="async"
        />
        <figcaption>Terrain · Processus · Humain</figcaption>
      </figure>
      <div class="hero-note-card">
        <p class="mini-kicker">Visite terrain</p>
        <h2>On part d’une tâche réelle.</h2>
        <ul>
          <li>Quels messages arrivent par WhatsApp ou email ?</li>
          <li>Qu’est-ce qui finit dans Excel ou dans un dossier client ?</li>
          <li>Quel prototype tester sans bouleverser l’équipe ?</li>
        </ul>
        <a href={site.whatsappHref}>Poser une question sur WhatsApp</a>
      </div>
    </aside>
  </div>
</section>
