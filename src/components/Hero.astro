---
import { site } from "@utils/seo";
---

<section class="hero-section" data-reveal-scope>
  <div class="container-shell hero-centered">
    <!-- Centered Content: Title, Subtitle & Primary CTA -->
    <div class="hero-center-content" data-reveal>
      <h1 class="hero-title">
        Simplifiez la gestion de votre PME.
      </h1>
      <p class="section-copy">
        Solutions d’automatisation sur mesure pour les entreprises romandes.
      </p>
      
      <!-- Primary Coral CTA Button (Opens interactive options modal) -->
      <div class="hero-cta-container">
        <button id="hero-cta-trigger" class="hero-cta-btn" aria-haspopup="dialog" aria-controls="booking-modal">
          Diagnostic terrain gratuit
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- Centered fidedign Canton de Vaud SVG Map (without names, clean silhouette) -->
    <div class="hero-map-centered" data-reveal>
      <svg
        viewBox="0 0 500 300"
        class="lake-map-svg"
        aria-label="Carte géographique fidedigne du Canton de Vaud"
      >
        <!-- 100% Geographically Accurate Closed-Loop Canton de Vaud Polygon (from OSM Relation 1702421) -->
        <path
          id="vaud-polygon"
          d="M 303.9,72.6 L 307.7,65.3 L 305.5,63.4 L 301.0,63.0 L 303.9,61.9 L 304.6,58.2 L 301.5,44.2 L 308.8,52.3 L 307.6,54.2 L 313.6,59.7 L 317.2,62.4 L 315.0,58.7 L 316.5,57.2 L 319.2,57.4 L 319.6,68.3 L 321.0,69.5 L 321.6,74.6 L 320.6,76.5 L 316.4,74.8 L 314.9,77.7 L 316.5,82.5 L 314.5,87.3 L 305.1,95.3 L 304.5,97.8 L 308.8,97.7 L 310.5,99.6 L 310.1,102.8 L 294.7,122.0 L 295.0,127.5 L 291.1,128.0 L 288.6,126.7 L 284.7,130.8 L 281.3,130.6 L 281.0,148.2 L 279.7,153.6 L 283.7,151.0 L 288.0,153.5 L 291.2,151.1 L 294.3,152.8 L 296.8,156.9 L 301.3,155.6 L 302.1,157.0 L 293.5,166.6 L 292.8,164.5 L 287.7,165.4 L 286.7,163.7 L 283.3,169.2 L 284.8,172.1 L 287.2,173.3 L 291.0,178.9 L 301.7,171.7 L 301.6,174.6 L 303.3,173.1 L 314.2,176.9 L 318.0,180.3 L 319.4,189.5 L 321.8,192.4 L 320.3,196.5 L 327.7,193.2 L 332.2,185.1 L 350.2,177.6 L 356.1,168.5 L 358.9,168.3 L 365.3,162.8 L 370.0,165.0 L 373.9,160.9 L 376.4,164.9 L 376.5,176.5 L 372.6,181.5 L 373.4,191.7 L 372.3,194.2 L 365.7,195.7 L 368.6,204.1 L 365.5,214.1 L 368.3,215.4 L 369.8,219.6 L 372.7,220.6 L 362.7,249.6 L 357.1,254.5 L 356.0,257.4 L 353.6,259.3 L 351.0,259.3 L 348.5,265.6 L 343.1,270.2 L 337.6,271.1 L 331.5,274.7 L 309.5,235.8 L 298.7,223.3 L 299.0,215.9 L 285.3,200.0 L 187.7,206.0 L 154.5,223.0 L 147.3,219.8 L 146.2,222.6 L 150.5,224.4 L 151.6,226.8 L 144.4,241.0 L 136.9,235.6 L 136.2,233.2 L 138.8,227.6 L 142.8,223.9 L 144.1,216.8 L 143.1,214.8 L 141.9,215.5 L 131.1,207.7 L 124.6,199.8 L 124.6,188.0 L 139.8,168.5 L 132.7,153.3 L 153.6,134.7 L 166.8,120.4 L 191.7,104.8 L 195.6,99.0 L 206.5,89.0 L 201.8,80.3 L 209.1,67.8 L 223.5,63.7 L 253.9,45.2 L 263.7,41.6 L 263.1,48.9 L 267.5,56.8 L 266.7,61.9 L 274.5,81.4 L 277.9,83.9 L 276.2,85.4 L 280.1,88.6 L 282.4,88.3 L 286.4,91.8 L 291.6,88.2 L 294.2,87.9 L 297.4,90.9 L 306.0,88.0 L 309.0,81.6 L 306.5,80.2 L 305.2,81.9 L 303.5,76.0 L 303.9,72.6 Z M 332.4,27.3 L 336.6,32.4 L 336.4,39.9 L 342.9,52.3 L 337.7,56.6 L 338.9,61.0 L 333.3,68.4 L 330.2,67.8 L 331.8,65.2 L 330.5,62.2 L 331.5,60.6 L 328.1,59.1 L 323.8,60.2 L 321.1,46.3 L 316.2,44.5 L 331.4,27.0 Z"
          fill="var(--accent)"
          fill-opacity="0.18"
          stroke="var(--accent)"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
      </svg>
    </div>
  </div>
</section>

<!-- Gorgeous glassmorphic options modal -->
<div id="booking-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
  <div class="modal-content">
    <button class="modal-close" aria-label="Fermer la fenêtre">&times;</button>
    <h2 id="modal-title">Diagnostic terrain gratuit</h2>
    <p class="modal-subtitle">Sélectionnez le moyen de contact le plus simple pour vous.</p>
    
    <div class="modal-options">
      <!-- Option 1: Google Calendar -->
      <a
        href={site.bookingHref}
        target={site.bookingIsConfigured ? "_blank" : undefined}
        rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
        class="modal-opt-card"
      >
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Réserver sur Google Calendar</h3>
          <p>Choisissez un créneau de 30 min en ligne</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 2: WhatsApp -->
      <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Écrire sur WhatsApp</h3>
          <p>Envoyez-moi un message direct et rapide</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 3: Call Directly -->
      <a href={site.phoneHref} class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Appeler directement</h3>
          <p>Parler de vive voix au {site.phone}</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 4: Contact Form -->
      <a href="#contact" id="modal-opt-form" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Remplir le formulaire</h3>
          <p>Envoyer un message écrit en bas de page</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('hero-cta-trigger');
    const modal = document.getElementById('booking-modal');
    const closeBtn = modal?.querySelector('.modal-close');
    const formLink = document.getElementById('modal-opt-form');

    if (!trigger || !modal) return;

    // Open Modal
    trigger.addEventListener('click', () => {
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden'; // Prevent body scroll
    });

    const closeModal = () => {
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('is-open');
      document.body.style.overflow = ''; // Restore body scroll
    };

    // Close Modal
    closeBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Close when choosing contact form (scrolls to bottom)
    formLink?.addEventListener('click', () => {
      closeModal();
    });
  });
</script>
