---
import { site } from "@utils/seo";
---

<section class="hero-section" data-reveal-scope>
  <div class="container-shell hero-centered">
    <!-- Centered Content: Title, Subtitle & Primary CTA -->
    <div class="hero-center-content" data-reveal>
      <h1 class="hero-title">
        Simplifiez la gestion de votre PME.
      </h1>
      <p class="section-copy">
        Solutions d’automatisation sur mesure pour les entreprises romandes.
      </p>
      
      <!-- Primary Coral CTA Button (Opens interactive options modal) -->
      <div class="hero-cta-container">
        <button id="hero-cta-trigger" class="hero-cta-btn" aria-haspopup="dialog" aria-controls="booking-modal">
          Diagnostic terrain gratuit
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- Centered fidedign Canton de Vaud SVG Map (without names, clean silhouette) -->
    <div class="hero-map-centered" data-reveal>
      <svg
        viewBox="0 0 500 300"
        class="lake-map-svg"
        aria-label="Carte géographique fidedigne du Canton de Vaud"
      >
        <!-- 100% Geographically Accurate Closed-Loop Canton de Vaud Polygon (from OSM Relation 1702421) -->
        <path
          id="vaud-polygon"
          d="M 66.3,158.8 L 71.1,145.1 L 112.6,122.7 L 147.3,109.1 L 155.9,102.5 L 176.4,94.1 L 170.4,83.1 L 175.9,74.8 L 202.9,69.1 L 266.3,46.8 L 278.9,60.8 L 278.1,64.3 L 285.0,64.9 L 295.0,85.3 L 293.2,87.9 L 309.5,94.0 L 323.4,90.5 L 329.1,93.2 L 339.7,91.8 L 347.5,84.6 L 340.0,82.2 L 338.5,77.8 L 343.1,71.9 L 342.6,67.1 L 334.4,66.4 L 342.1,65.4 L 335.2,61.0 L 346.3,55.9 L 345.1,58.1 L 355.6,63.7 L 361.5,60.5 L 367.8,64.0 L 363.8,70.5 L 368.7,77.2 L 365.4,79.4 L 359.9,77.9 L 357.0,80.6 L 358.8,86.1 L 356.1,88.1 L 356.4,89.9 L 350.6,91.5 L 348.4,94.8 L 339.5,99.6 L 347.5,100.2 L 349.2,101.0 L 349.2,104.6 L 323.7,123.2 L 326.0,123.9 L 321.4,128.5 L 311.1,127.9 L 302.2,131.2 L 300.9,133.7 L 302.2,143.3 L 299.5,152.3 L 301.7,153.6 L 308.3,151.1 L 310.9,152.9 L 317.1,151.1 L 328.6,156.1 L 336.2,156.4 L 322.8,166.8 L 320.4,164.1 L 311.3,164.8 L 309.9,163.2 L 304.8,168.5 L 315.9,177.1 L 324.3,175.9 L 335.3,170.4 L 335.4,173.3 L 339.2,172.4 L 358.1,176.9 L 362.1,179.1 L 364.5,183.3 L 364.3,187.4 L 368.7,191.1 L 367.7,194.7 L 375.2,192.4 L 381.6,186.4 L 420.0,173.5 L 426.9,167.9 L 434.7,165.2 L 447.2,164.8 L 455.2,160.0 L 459.9,169.9 L 458.6,175.5 L 452.9,180.0 L 452.4,190.4 L 441.2,193.9 L 445.5,202.5 L 442.0,209.0 L 443.0,212.4 L 451.9,216.8 L 440.1,240.7 L 425.4,252.7 L 415.7,255.3 L 415.1,259.0 L 412.7,260.8 L 401.2,265.9 L 382.6,268.8 L 367.5,250.8 L 349.8,237.2 L 347.3,227.5 L 334.2,223.5 L 330.4,220.4 L 331.4,214.3 L 329.1,212.2 L 290.5,195.0 L 92.7,220.1 L 82.9,217.5 L 78.6,219.6 L 85.7,221.5 L 87.6,223.7 L 71.7,236.4 L 61.8,230.3 L 66.3,224.7 L 72.8,221.3 L 75.1,213.9 L 54.5,206.0 L 44.7,195.8 L 43.2,186.7 L 58.9,172.0 L 398.1,57.5 L 398.9,58.4 L 394.7,60.3 L 396.2,64.8 L 387.6,71.5 L 382.3,71.1 L 385.5,67.8 L 382.7,65.9 L 384.1,64.0 L 377.4,62.2 L 371.7,63.8 L 374.3,60.0 L 366.8,54.4 L 366.2,49.8 L 359.8,48.9 L 386.7,32.3 L 403.9,54.9 Z"
          fill="var(--accent)"
          fill-opacity="0.18"
          stroke="var(--accent)"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
      </svg>
    </div>
  </div>
</section>

<!-- Gorgeous glassmorphic options modal -->
<div id="booking-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
  <div class="modal-content">
    <button class="modal-close" aria-label="Fermer la fenêtre">&times;</button>
    <h2 id="modal-title">Diagnostic terrain gratuit</h2>
    <p class="modal-subtitle">Sélectionnez le moyen de contact le plus simple pour vous.</p>
    
    <div class="modal-options">
      <!-- Option 1: Google Calendar -->
      <a
        href={site.bookingHref}
        target={site.bookingIsConfigured ? "_blank" : undefined}
        rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
        class="modal-opt-card"
      >
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Réserver sur Google Calendar</h3>
          <p>Choisissez un créneau de 30 min en ligne</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 2: WhatsApp -->
      <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Écrire sur WhatsApp</h3>
          <p>Envoyez-moi un message direct et rapide</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 3: Call Directly -->
      <a href={site.phoneHref} class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Appeler directement</h3>
          <p>Parler de vive voix au {site.phone}</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 4: Contact Form -->
      <a href="#contact" id="modal-opt-form" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Remplir le formulaire</h3>
          <p>Envoyer un message écrit en bas de page</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('hero-cta-trigger');
    const modal = document.getElementById('booking-modal');
    const closeBtn = modal?.querySelector('.modal-close');
    const formLink = document.getElementById('modal-opt-form');

    if (!trigger || !modal) return;

    // Open Modal
    trigger.addEventListener('click', () => {
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden'; // Prevent body scroll
    });

    const closeModal = () => {
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('is-open');
      document.body.style.overflow = ''; // Restore body scroll
    };

    // Close Modal
    closeBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Close when choosing contact form (scrolls to bottom)
    formLink?.addEventListener('click', () => {
      closeModal();
    });
  });
</script>
