---
import { site } from "@utils/seo";
---

<section class="hero-section" data-reveal-scope>
  <div class="container-shell hero-split">
    <!-- Left Column: Copy & Primary CTA -->
    <div class="hero-left" data-reveal>
      <h1 class="hero-title">
        Simplifiez la gestion de votre PME.
      </h1>
      <p class="section-copy">
        Solutions d’automatisation sur mesure pour les entreprises romandes.
      </p>
      <a href="#contact" class="hero-cta-btn">
        Découvrir nos solutions
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Right Column: Precise Geographic SVG Map and Network Overlay -->
    <div class="hero-right" data-reveal>
      <svg
        viewBox="0 0 500 300"
        class="lake-map-svg"
        aria-label="Carte vectorielle du Lac Léman interconnecté"
      >
        <defs>
          <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Topological Alps & Jura mountain contour lines (Representing region) -->
        <path d="M 15,245 C 75,185 135,205 215,165 C 295,125 355,165 485,115" fill="none" stroke="var(--muted)" stroke-width="1.2" opacity="0.12" />
        <path d="M 5,215 C 75,155 155,185 235,135 C 315,85 385,125 485,75" fill="none" stroke="var(--muted)" stroke-width="1.2" opacity="0.08" />
        <path d="M 25,275 C 95,215 175,225 265,185 C 355,145 405,185 485,135" fill="none" stroke="var(--muted)" stroke-width="1.2" opacity="0.1" />
        <path d="M 5,185 C 75,125 155,145 225,105 C 295,65 385,105 485,55" fill="none" stroke="var(--muted)" stroke-width="1.2" opacity="0.06" />

        <!-- Geographically Accurate Crescent-moon Lac Léman Path Shape -->
        <path
          id="lake-polygon"
          d="M 60,240
             C 70,220 78,195 86,170
             C 96,150 110,132 130,118
             C 152,102 180,94 212,88
             C 238,83 268,82 296,87
             C 328,93 360,103 392,118
             C 424,133 452,152 470,172
             C 475,178 472,182 465,182
             C 450,181 432,176 414,168
             C 392,159 368,148 344,142
             C 320,136 295,135 270,137
             C 240,140 210,147 182,158
             C 152,170 125,186 102,206
             C 85,221 72,236 60,240 Z"
          fill="var(--accent)"
          fill-opacity="0.18"
          stroke="var(--accent)"
          stroke-width="2"
          stroke-linejoin="round"
        />

        <!-- Connected Workflows network lines overlay -->
        <g stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="3,3" opacity="0.85">
          <line x1="60" y1="240" x2="98" y2="155" />
          <line x1="98" y1="155" x2="175" y2="108" />
          <line x1="175" y1="108" x2="240" y2="86" />
          <line x1="240" y1="86" x2="370" y2="111" />
          <line x1="60" y1="240" x2="240" y2="86" stroke-width="0.8" opacity="0.3" stroke-dasharray="none" />
          <line x1="98" y1="155" x2="240" y2="86" stroke-width="0.8" opacity="0.3" stroke-dasharray="none" />
          <line x1="175" y1="108" x2="370" y2="111" stroke-width="0.8" opacity="0.3" stroke-dasharray="none" />
        </g>

        <!-- Interactive glowing nodes for city hubs -->
        <!-- Genève -->
        <g class="city-node" transform="translate(60,240)">
          <circle r="10" fill="var(--cta)" opacity="0.22" class="node-glow" />
          <circle r="4.5" fill="var(--cta)" filter="url(#glow)" />
        </g>
        <!-- Nyon -->
        <g class="city-node" transform="translate(98,155)">
          <circle r="8" fill="var(--muted)" opacity="0.18" class="node-glow" />
          <circle r="3.5" fill="var(--muted)" />
        </g>
        <!-- Morges -->
        <g class="city-node" transform="translate(175,108)">
          <circle r="8" fill="var(--muted)" opacity="0.18" class="node-glow" />
          <circle r="3.5" fill="var(--muted)" />
        </g>
        <!-- Lausanne -->
        <g class="city-node" transform="translate(240,86)">
          <circle r="10" fill="var(--muted)" opacity="0.22" class="node-glow" />
          <circle r="4.5" fill="var(--muted)" filter="url(#glow)" />
        </g>
        <!-- Vevey -->
        <g class="city-node" transform="translate(370,111)">
          <circle r="8" fill="var(--muted)" opacity="0.18" class="node-glow" />
          <circle r="3.5" fill="var(--muted)" />
        </g>

        <!-- Swiss precise typography labels -->
        <text x="36" y="262" font-size="10" font-weight="700" fill="var(--fg)" font-family="var(--font-body)">Genève</text>
        <text x="73" y="152" font-size="10" font-weight="700" fill="var(--fg)" font-family="var(--font-body)">Nyon</text>
        <text x="145" y="103" font-size="10" font-weight="700" fill="var(--fg)" font-family="var(--font-body)">Morges</text>
        <text x="216" y="72" font-size="10" font-weight="700" fill="var(--fg)" font-family="var(--font-body)">Lausanne</text>
        <text x="378" y="108" font-size="10" font-weight="700" fill="var(--fg)" font-family="var(--font-body)">Vevey</text>
      </svg>
    </div>
  </div>
</section>
