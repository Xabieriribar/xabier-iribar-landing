---
import { site } from "@utils/seo";
---

<section class="hero-section" data-reveal-scope>
  <div class="container-shell hero-centered">
    <!-- Centered Content: Title, Subtitle & Primary CTA -->
    <div class="hero-center-content" data-reveal>
      <h1 class="hero-title">
        Simplifiez la gestion de votre PME.
      </h1>
      <p class="section-copy">
        Solutions d’automatisation sur mesure pour les entreprises romandes.
      </p>
      
      <!-- Primary Coral CTA Button (Opens interactive options modal) -->
      <div class="hero-cta-container">
        <button id="hero-cta-trigger" class="hero-cta-btn" aria-haspopup="dialog" aria-controls="booking-modal">
          Diagnostic terrain gratuit
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- Centered fidedign Lac Léman SVG Map (without names, clean silhouette) -->
    <div class="hero-map-centered" data-reveal>
      <svg
        viewBox="0 0 500 300"
        class="lake-map-svg"
        aria-label="Carte géographique fidedigne du Lac Léman"
      >
        <!-- Surrounding mountain relief contour lines (representing Alps & Jura) -->
        <path d="M 15,245 C 75,185 135,205 215,165 C 295,125 355,165 485,115" fill="none" stroke="var(--muted)" stroke-width="1.2" opacity="0.12" />
        <path d="M 5,215 C 75,155 155,185 235,135 C 315,85 385,125 485,75" fill="none" stroke="var(--muted)" stroke-width="1.2" opacity="0.08" />
        <path d="M 25,275 C 95,215 175,225 265,185 C 355,145 405,185 485,135" fill="none" stroke="var(--muted)" stroke-width="1.2" opacity="0.1" />
        <path d="M 5,185 C 75,125 155,145 225,105 C 295,65 385,105 485,55" fill="none" stroke="var(--muted)" stroke-width="1.2" opacity="0.06" />

        <!-- 100% Geographically Accurate Closed-Loop Lac Léman Polygon (from OSM Relation 332617) -->
        <path
          id="lake-polygon"
          d="M 227.3,39.2 L 220.2,43.2 L 217.6,50.2 L 211.2,50.9 L 207.5,54.1 L 206.4,60.3 L 183.1,68.4 L 175.0,74.5 L 169.6,75.4 L 156.8,70.5 L 141.6,73.9 L 137.2,77.1 L 136.1,81.3 L 126.5,87.1 L 119.6,96.9 L 110.6,102.7 L 110.1,109.0 L 105.2,115.9 L 105.5,122.3 L 100.9,128.0 L 91.7,126.4 L 79.0,138.8 L 63.4,160.6 L 63.3,166.8 L 57.9,182.0 L 42.7,200.5 L 43.4,206.1 L 40.7,211.0 L 43.1,217.6 L 40.3,225.4 L 37.7,225.6 L 32.1,234.0 L 30.7,253.1 L 33.7,264.2 L 30.3,267.8 L 31.3,269.4 L 43.7,264.1 L 41.6,261.5 L 45.1,261.7 L 54.1,247.7 L 57.4,226.2 L 64.9,223.0 L 75.3,207.4 L 79.2,205.1 L 83.1,198.4 L 82.2,194.1 L 88.9,188.4 L 91.9,181.6 L 91.0,178.2 L 100.6,165.8 L 102.5,158.9 L 116.4,146.6 L 128.7,142.1 L 143.3,145.2 L 148.8,158.8 L 165.1,166.1 L 179.0,151.2 L 189.3,150.9 L 214.8,139.4 L 219.1,125.4 L 235.1,116.8 L 253.4,124.5 L 278.6,118.8 L 304.3,115.9 L 320.5,116.9 L 327.9,114.7 L 353.9,114.4 L 371.9,118.3 L 391.6,125.8 L 398.7,124.8 L 413.4,131.4 L 422.0,129.3 L 427.2,131.3 L 430.0,128.7 L 429.0,124.6 L 433.5,126.0 L 444.2,123.7 L 444.6,120.7 L 446.2,123.9 L 449.9,124.6 L 453.5,122.9 L 462.3,124.9 L 463.1,122.6 L 465.9,122.5 L 469.9,112.8 L 463.6,98.4 L 457.5,97.1 L 457.7,93.5 L 452.8,89.5 L 446.7,90.4 L 437.9,84.0 L 430.1,84.6 L 425.5,77.1 L 416.1,74.0 L 414.2,68.7 L 384.0,63.7 L 365.3,52.3 L 352.4,54.5 L 340.4,45.5 L 327.2,40.9 L 302.6,38.7 L 299.1,40.8 L 277.8,30.4 L 274.2,30.2 L 258.5,38.4 L 247.7,38.4 L 240.1,32.6 L 233.1,31.8 L 230.2,33.3 L 227.3,39.2 Z"
          fill="var(--accent)"
          fill-opacity="0.18"
          stroke="var(--accent)"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
      </svg>
    </div>
  </div>
</section>

<!-- Gorgeous glassmorphic options modal -->
<div id="booking-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
  <div class="modal-content">
    <button class="modal-close" aria-label="Fermer la fenêtre">&times;</button>
    <h2 id="modal-title">Diagnostic terrain gratuit</h2>
    <p class="modal-subtitle">Sélectionnez le moyen de contact le plus simple pour vous.</p>
    
    <div class="modal-options">
      <!-- Option 1: Google Calendar -->
      <a
        href={site.bookingHref}
        target={site.bookingIsConfigured ? "_blank" : undefined}
        rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
        class="modal-opt-card"
      >
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Réserver sur Google Calendar</h3>
          <p>Choisissez un créneau de 30 min en ligne</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 2: WhatsApp -->
      <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Écrire sur WhatsApp</h3>
          <p>Envoyez-moi un message direct et rapide</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 3: Call Directly -->
      <a href={site.phoneHref} class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Appeler directement</h3>
          <p>Parler de vive voix au {site.phone}</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 4: Contact Form -->
      <a href="#contact" id="modal-opt-form" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Remplir le formulaire</h3>
          <p>Envoyer un message écrit en bas de page</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('hero-cta-trigger');
    const modal = document.getElementById('booking-modal');
    const closeBtn = modal?.querySelector('.modal-close');
    const formLink = document.getElementById('modal-opt-form');

    if (!trigger || !modal) return;

    // Open Modal
    trigger.addEventListener('click', () => {
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden'; // Prevent body scroll
    });

    const closeModal = () => {
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('is-open');
      document.body.style.overflow = ''; // Restore body scroll
    };

    // Close Modal
    closeBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Close when choosing contact form (scrolls to bottom)
    formLink?.addEventListener('click', () => {
      closeModal();
    });
  });
</script>
