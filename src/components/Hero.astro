---
import { site } from "@utils/seo";
---

<section class="hero-section" data-reveal-scope>
  <div class="container-shell hero-grid">
    <div class="hero-copy">
      <p class="location-line" data-reveal>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        Basé à Aclens · Lausanne/Vaud
      </p>

      <h1 class="hero-title" data-reveal>
        Automatisation IA pour PME à Lausanne/Vaud, pensée pour le terrain.
      </h1>

      <p class="section-copy" data-reveal>
        J’aide les PME locales à gagner du temps sur leurs demandes clients, devis, relances et documents grâce à des processus simples, rapides et validés par l’humain.
      </p>

      <p class="terrain-line" data-reveal>Je pars du terrain, pas de la technologie.</p>

      <a href="#contact" class="btn-primary hero-cta" data-reveal>
        Demander un diagnostic gratuit
        <span aria-hidden="true">→</span>
      </a>

      <div class="quick-links" aria-label="Moyens de contact rapides" data-reveal>
        <a href={site.whatsappHref}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M20 11.5a8 8 0 0 1-11.8 7l-4.2 1.2 1.2-4A8 8 0 1 1 20 11.5Z" />
            <path d="M8.8 8.8c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .5.4l.7 1.5c.1.3.1.4-.1.6l-.3.4c-.1.1-.2.3-.1.5.3.7 1.2 1.8 2.5 2.4.2.1.4.1.5-.1l.6-.7c.2-.2.4-.2.6-.1l1.5.7c.3.1.4.3.3.6-.1.6-.8 1.2-1.4 1.2-1 0-3.3-.8-5.1-2.6-1.5-1.5-2.4-3.5-2.4-4.3Z" />
          </svg>
          WhatsApp
        </a>
        <a href={site.phoneHref}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M22 16.9v3a2 2 0 0 1-2.18 2 19.7 19.7 0 0 1-8.59-3.05 19.4 19.4 0 0 1-6-6A19.7 19.7 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.62a2 2 0 0 1-.45 2.11L8 9.7a16 16 0 0 0 6.3 6.3l1.25-1.27a2 2 0 0 1 2.11-.45c.84.29 1.72.5 2.62.62A2 2 0 0 1 22 16.9Z" />
          </svg>
          Appeler maintenant
        </a>
        <a href={`mailto:${site.email}`}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M4 5h16v14H4z" />
            <path d="m4 7 8 6 8-6" />
          </svg>
          Écrire un email
        </a>
      </div>
    </div>

    <div class="portrait-wrap" data-reveal>
      <figure class="portrait-card" aria-label="Portrait de Xabier Iribar">
        <img
          src="/assets/xabier-iribar-portrait.png"
          alt="Portrait de Xabier Iribar"
          width="1254"
          height="1254"
          loading="eager"
        />
        <figcaption>Terrain · Processus · Humain</figcaption>
      </figure>
    </div>
  </div>
</section>
