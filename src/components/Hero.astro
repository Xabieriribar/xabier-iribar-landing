---
import { site } from "@utils/seo";
---

<section class="hero-section" data-reveal-scope>
  <div class="container-shell hero-centered">
    <!-- Centered Content: Title, Subtitle & Primary CTA -->
    <div class="hero-center-content" data-reveal>
      <div class="hero-eyebrow-container">
        <span class="hero-eyebrow">AUTOMATISATION LOCALE — ACLENS / REGION LAUSANNOISE</span>
      </div>
      <h1 class="hero-title">
        Moins de copier-coller entre vos emails, WhatsApp et Excel.
      </h1>
      <p class="section-copy">
        J'aide les artisans, garages et PME du canton de Vaud à automatiser leurs tâches administratives courantes sans changer vos habitudes ni vos outils.
      </p>
      
      <!-- Primary Coral CTA Button (Opens interactive options modal) & Micro-reassurance -->
      <div class="hero-cta-container">
        <button id="hero-cta-trigger" class="hero-cta-btn" aria-haspopup="dialog" aria-controls="booking-modal">
          Diagnostic terrain gratuit
          <span aria-hidden="true">→</span>
        </button>
        <p class="hero-micro-reassurance">
          « Échange de 30 minutes sur place ou par téléphone, sans engagement. »
        </p>
      </div>
    </div>

    <!-- Centered fidedign Canton de Vaud SVG Map (without names, clean silhouette) -->
    <div class="hero-map-centered" data-reveal>
      <div id="vaud-3d-container" class="vaud-3d-container">
        <canvas id="vaud-3d-canvas" aria-label="Carte 3D interactive fidedigne du Canton de Vaud"></canvas>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-eyebrow-container {
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .hero-eyebrow {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 100px;
    background: rgba(27, 38, 59, 0.06);
    color: var(--accent);
    font-size: clamp(0.72rem, 1.8vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid rgba(27, 38, 59, 0.12);
    box-shadow: 0 2px 8px rgba(27, 38, 59, 0.03);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .hero-cta-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 38px;
    width: 100%;
  }
  .hero-micro-reassurance {
    font-size: clamp(0.8rem, 1.8vw, 0.88rem);
    color: var(--muted);
    margin-top: 14px;
    font-style: italic;
    font-weight: 500;
    max-width: 480px;
    line-height: 1.45;
    text-align: center;
  }
  .vaud-3d-container {
    width: 100%;
    height: 380px;
    position: relative;
    overflow: visible;
    outline: none;
    cursor: grab;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
  }
  .vaud-3d-container:active {
    cursor: grabbing;
  }
  #vaud-3d-canvas {
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
  }
</style>

<!-- Gorgeous glassmorphic options modal -->
<div id="booking-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
  <div class="modal-content">
    <button class="modal-close" aria-label="Fermer la fenêtre">&times;</button>
    <h2 id="modal-title">Diagnostic terrain gratuit</h2>
    <p class="modal-subtitle">Sélectionnez le moyen de contact le plus simple pour vous.</p>
    
    <div class="modal-options">
      <!-- Option 1: Google Calendar -->
      <a
        href={site.bookingHref}
        target={site.bookingIsConfigured ? "_blank" : undefined}
        rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
        class="modal-opt-card"
      >
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Réserver sur Google Calendar</h3>
          <p>Choisissez un créneau de 30 min en ligne</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 2: WhatsApp -->
      <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Écrire sur WhatsApp</h3>
          <p>Envoyez-moi un message direct et rapide</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 3: Call Directly -->
      <a href={site.phoneHref} class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Appeler directement</h3>
          <p>Parler de vive voix au {site.phone}</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 4: Contact Form -->
      <a href="#contact" id="modal-opt-form" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Remplir le formulaire</h3>
          <p>Envoyer un message écrit en bas de page</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('hero-cta-trigger');
    const modal = document.getElementById('booking-modal');
    const closeBtn = modal?.querySelector('.modal-close');
    const formLink = document.getElementById('modal-opt-form');

    if (!trigger || !modal) return;

    // Open Modal
    trigger.addEventListener('click', () => {
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden'; // Prevent body scroll
    });

    const closeModal = () => {
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('is-open');
      document.body.style.overflow = ''; // Restore body scroll
    };

    // Close Modal
    closeBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Close when choosing contact form (scrolls to bottom)
    formLink?.addEventListener('click', () => {
      closeModal();
    });
  });
</script>

<script>
  // Dynamically import Three.js safely inside browser client context
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('vaud-3d-container');
    const canvas = document.getElementById('vaud-3d-canvas');
    if (!container || !canvas) return;

    // 100% Accurate Shore-subtracted Vaud Path Coordinate String
    const pathData = "M 186.8,107.7 L 188.9,105.1 L 190.9,105.1 L 192.4,101.1 L 203.4,95.1 L 203.6,78.2 L 206.4,69.6 L 219.5,66.3 L 228.5,60.6 L 239.3,56.3 L 249.5,48.0 L 258.6,43.0 L 263.9,43.9 L 263.7,50.4 L 267.6,53.5 L 268.1,57.4 L 266.6,61.2 L 270.5,61.4 L 275.0,81.9 L 277.3,84.4 L 275.7,86.6 L 278.6,87.0 L 286.2,91.8 L 292.3,87.9 L 297.6,90.8 L 304.3,89.3 L 309.0,82.2 L 308.2,80.6 L 303.7,81.0 L 304.3,71.9 L 307.1,65.0 L 305.3,63.2 L 301.1,63.0 L 304.3,61.7 L 303.8,58.8 L 307.4,51.1 L 308.8,52.3 L 307.7,54.3 L 313.2,59.7 L 316.3,60.8 L 314.8,57.9 L 317.4,56.4 L 320.8,59.6 L 319.3,68.7 L 321.0,69.6 L 321.6,74.7 L 320.2,76.6 L 316.3,74.7 L 315.1,80.4 L 316.6,82.6 L 314.4,87.5 L 310.7,89.4 L 309.8,92.3 L 304.9,95.5 L 304.5,97.9 L 308.8,97.7 L 310.8,100.2 L 310.0,102.9 L 294.6,121.9 L 295.9,123.5 L 295.4,126.9 L 291.7,128.3 L 288.8,126.5 L 284.6,130.8 L 281.6,130.4 L 279.7,153.6 L 285.3,151.1 L 287.4,153.4 L 290.4,151.3 L 298.2,156.7 L 302.4,156.0 L 302.0,158.5 L 298.3,160.9 L 293.5,167.5 L 292.0,164.4 L 288.1,165.4 L 286.2,165.0 L 286.3,163.9 L 283.2,169.3 L 290.0,178.3 L 294.3,179.1 L 301.6,170.8 L 301.4,173.6 L 304.6,173.3 L 310.2,176.9 L 313.4,176.5 L 317.9,180.8 L 322.7,196.1 L 325.8,194.2 L 328.5,189.3 L 336.6,181.6 L 346.6,180.2 L 354.9,168.8 L 358.5,168.5 L 362.4,165.6 L 369.5,165.6 L 374.6,160.4 L 377.3,171.0 L 376.1,177.2 L 374.3,178.6 L 374.1,181.0 L 372.0,181.9 L 373.2,191.1 L 367.6,196.2 L 366.2,195.8 L 366.0,198.7 L 368.7,203.1 L 366.4,211.4 L 366.9,215.0 L 372.7,219.9 L 364.1,249.0 L 361.8,250.0 L 354.9,258.1 L 350.4,260.0 L 350.0,263.5 L 347.7,266.4 L 341.8,270.8 L 339.4,270.8 L 332.0,274.6 L 326.0,267.5 L 321.2,255.0 L 309.7,237.4 L 306.7,227.7 L 301.1,226.6 L 298.4,222.6 L 299.2,216.3 L 293.5,210.1 L 299.1,209.8 L 299.2,208.5 L 299.7,209.6 L 299.4,208.5 L 301.3,210.1 L 307.3,209.4 L 308.9,205.4 L 306.8,199.9 L 304.2,198.9 L 302.4,195.8 L 300.1,196.2 L 296.7,193.5 L 293.8,193.8 L 291.9,190.7 L 288.4,189.5 L 287.7,187.4 L 276.1,185.3 L 268.6,180.5 L 264.0,181.5 L 259.7,177.9 L 254.5,176.2 L 243.8,175.8 L 235.6,171.5 L 228.5,174.8 L 224.0,174.8 L 220.0,172.2 L 217.9,172.3 L 213.5,176.8 L 212.5,179.7 L 209.5,180.4 L 208.1,183.5 L 205.1,185.4 L 194.4,190.0 L 189.5,188.0 L 183.4,189.3 L 174.4,199.4 L 171.6,201.1 L 169.6,209.2 L 168.0,211.3 L 165.2,210.7 L 162.7,212.0 L 154.6,223.0 L 148.3,219.9 L 145.9,222.2 L 153.4,227.6 L 151.4,233.7 L 146.8,240.1 L 145.6,241.3 L 137.7,236.5 L 135.9,233.7 L 138.2,230.8 L 138.6,227.6 L 142.7,224.2 L 144.6,217.2 L 143.2,214.9 L 131.5,208.4 L 130.2,206.0 L 123.0,202.6 L 127.5,194.7 L 124.6,188.0 L 133.2,174.2 L 137.8,158.3 L 139.4,146.5 L 147.6,140.3 L 166.8,121.4 L 186.8,107.7 Z M 330.0,26.6 L 336.6,32.4 L 336.4,39.9 L 342.9,52.3 L 340.0,53.6 L 340.8,53.9 L 337.7,56.6 L 338.9,61.0 L 333.3,68.4 L 330.2,67.8 L 331.8,65.2 L 330.7,59.7 L 323.8,60.2 L 319.9,45.3 L 316.3,44.5 L 330.0,26.6 Z";

    // 1. Parse loops into THREE.Shape
    const shapes = [];
    const parts = pathData.split('M').filter(p => p.trim());
    
    for (const part of parts) {
      const cleanPart = part.replace('Z', '').trim();
      const coords = cleanPart.split(/L| /).map(s => s.trim()).filter(s => s);
      const points = [];
      for (let i = 0; i < coords.length; i++) {
        const coord = coords[i];
        if (!coord.includes(',')) continue;
        const [xStr, yStr] = coord.split(',');
        const x = parseFloat(xStr);
        const y = parseFloat(yStr);
        if (!isNaN(x) && !isNaN(y)) {
          points.push(new THREE.Vector2(x, y));
        }
      }
      if (points.length > 2) {
        const shape = new THREE.Shape(points);
        shapes.push(shape);
      }
    }

    if (shapes.length === 0) return;

    // 2. Set up Three.js Scene, Camera, and Renderer
    const scene = new THREE.Scene();
    
    // Transparent background
    const renderer = new THREE.WebGLRenderer({ canvas: canvas as HTMLCanvasElement, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    
    const initialWidth = container.clientWidth || 500;
    const initialHeight = container.clientHeight || 380;
    renderer.setSize(initialWidth, initialHeight);

    // Camera setup
    const camera = new THREE.PerspectiveCamera(40, initialWidth / initialHeight, 0.1, 1000);
    camera.position.set(0, 0, 420);

    // 3. Create 3D Extruded Geometry
    const extrudeSettings = {
      depth: 14,
      bevelEnabled: true,
      bevelSegments: 4,
      steps: 1,
      bevelSize: 1.2,
      bevelThickness: 1.2
    };

    const geometry = new THREE.ExtrudeGeometry(shapes, extrudeSettings);
    geometry.center(); // Perfect centroid alignment

    // Group to hold mesh & outline together
    const vaudGroup = new THREE.Group();

    // Premium frosted teal-tinted glassmorphic Swiss material
    const material = new THREE.MeshPhysicalMaterial({
      color: 0x0F766E,         // Deep pine teal base
      roughness: 0.18,         // Fine frost texture
      metalness: 0.1,          // High glass realism
      transmission: 0.85,      // Frosted transparency
      thickness: 8.0,          // Thick custom glass refraction depth
      ior: 1.52,               // Standard glass Index of Refraction
      clearcoat: 1.0,          // Glossy surface glaze
      clearcoatRoughness: 0.1,
      flatShading: true,
      transparent: true,
      opacity: 0.95
    });

    const mesh = new THREE.Mesh(geometry, material);
    vaudGroup.add(mesh);

    // Elegant glowing neon-teal outline
    const wireframeGeom = new THREE.EdgesGeometry(geometry, 22);
    const wireframeMat = new THREE.LineBasicMaterial({
      color: 0x0D9488, // Vibrant neon teal
      transparent: true,
      opacity: 0.85
    });
    const wireframe = new THREE.LineSegments(wireframeGeom, wireframeMat);
    vaudGroup.add(wireframe);

    // Aclens / Lausanne Local Presence Indicator
    const aclensGeo = new THREE.SphereGeometry(3.5, 16, 16);
    const aclensMat = new THREE.MeshBasicMaterial({
      color: 0xF97316, // Beautiful warm orange neon glow
      transparent: true,
      opacity: 0.95
    });
    const aclensMesh = new THREE.Mesh(aclensGeo, aclensMat);
    aclensMesh.position.set(-30, 25, -8.5); // Placed precisely in the Lausanne city center on the front visible face
    vaudGroup.add(aclensMesh);

    // SVG coordinates have Y down; flip vertically to orient correctly in 3D
    vaudGroup.rotation.x = Math.PI;
    
    scene.add(vaudGroup);

    // 4. Lights setup
    const ambientLight = new THREE.AmbientLight(0x0f172a, 1.9); // Slate-navy ambient light
    scene.add(ambientLight);

    const dirLight1 = new THREE.DirectionalLight(0xffffff, 3.2); // Powerful white primary light
    dirLight1.position.set(200, 300, 400);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0x0d9488, 2.0); // Vibrant teal fill light
    dirLight2.position.set(-200, -100, -100);
    scene.add(dirLight2);

    const pointLight = new THREE.PointLight(0xffffff, 3.0, 350); // Direct specular point light
    pointLight.position.set(0, 0, 150);
    scene.add(pointLight);

    // 5. Interaction variables
    let isDragging = false;
    let previousMousePosition = { x: 0, y: 0 };
    
    // Slow initial automatic spin
    let rotationVelocity = { x: 0.002, y: 0.003 }; 
    let mouseX = 0;
    let mouseY = 0;

    // Handle Dragging
    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('mousemove', (e) => {
      if (isDragging) {
        const deltaMove = {
          x: e.clientX - previousMousePosition.x,
          y: e.clientY - previousMousePosition.y
        };

        vaudGroup.rotation.y += deltaMove.x * 0.006;
        vaudGroup.rotation.x += deltaMove.y * 0.006;

        rotationVelocity = {
          x: deltaMove.y * 0.0015,
          y: deltaMove.x * 0.0015
        };

        previousMousePosition = { x: e.clientX, y: e.clientY };
      } else {
        // Track hover for subtle tilt orientation
        mouseX = (e.clientX / window.innerWidth - 0.5) * 0.45;
        mouseY = (e.clientY / window.innerHeight - 0.5) * 0.45;
      }
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    // Touch Support for Mobile Dragging
    container.addEventListener('touchstart', (e) => {
      isDragging = true;
      previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      if (isDragging && e.touches.length === 1) {
        const deltaMove = {
          x: e.touches[0].clientX - previousMousePosition.x,
          y: e.touches[0].clientY - previousMousePosition.y
        };

        vaudGroup.rotation.y += deltaMove.x * 0.006;
        vaudGroup.rotation.x += deltaMove.y * 0.006;

        previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      }
    }, { passive: true });

    container.addEventListener('touchend', () => {
      isDragging = false;
    });

    // Bulletproof ResizeObserver for responsive design & scroll reveal visibility
    const resizeObserver = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const w = entry.contentRect.width || container.clientWidth;
        const h = entry.contentRect.height || container.clientHeight;
        if (w > 0 && h > 0) {
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        }
      }
    });
    resizeObserver.observe(container);

    // 6. Animation Loop
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);

      const elapsedTime = clock.getElapsedTime();

      // Pulse Aclens Presence Indicator (Orange Neon sphere scale + opacity glow)
      if (aclensMesh) {
        const pulseScale = 1.0 + Math.sin(elapsedTime * 4.5) * 0.22;
        aclensMesh.scale.set(pulseScale, pulseScale, pulseScale);
        aclensMat.opacity = 0.75 + Math.sin(elapsedTime * 4.5) * 0.25;
      }

      // Smooth point light position glide matching mouse coordinates
      pointLight.position.x += (mouseX * 500 - pointLight.position.x) * 0.08;
      pointLight.position.y += (-mouseY * 400 - pointLight.position.y) * 0.08;

      if (!isDragging) {
        // Soft floating animation + physics inertia decay
        vaudGroup.rotation.y += rotationVelocity.y + Math.sin(elapsedTime * 0.8) * 0.0005;
        vaudGroup.rotation.x += rotationVelocity.x + Math.cos(elapsedTime * 0.8) * 0.0005;

        // Apply mouse tilt orientation offset smoothly
        const targetRotY = mouseX;
        const targetRotX = Math.PI + mouseY; // Base flip offset
        
        vaudGroup.rotation.y += (targetRotY - vaudGroup.rotation.y) * 0.04;
        vaudGroup.rotation.x += (targetRotX - vaudGroup.rotation.x) * 0.04;

        // Decelerate drag velocity slowly
        rotationVelocity.x *= 0.95;
        rotationVelocity.y *= 0.95;
      }

      renderer.render(scene, camera);
    }

    animate();
  });
</script>
