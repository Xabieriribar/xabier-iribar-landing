---
import { site } from "@utils/seo";
---

<section class="hero-section" data-reveal-scope>
  <div class="container-shell hero-centered">
    <!-- Centered Content: Title, Subtitle & Primary CTA -->
    <div class="hero-center-content" data-reveal>
      <h1 class="hero-title">
        Simplifiez la gestion de votre PME.
      </h1>
      <p class="section-copy">
        Solutions d’automatisation sur mesure pour les entreprises romandes.
      </p>
      
      <!-- Primary Coral CTA Button (Opens interactive options modal) -->
      <div class="hero-cta-container">
        <button id="hero-cta-trigger" class="hero-cta-btn" aria-haspopup="dialog" aria-controls="booking-modal">
          Diagnostic terrain gratuit
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- Centered fidedign Canton de Vaud SVG Map (without names, clean silhouette) -->
    <div class="hero-map-centered" data-reveal>
      <svg
        viewBox="0 0 500 300"
        class="lake-map-svg"
        aria-label="Carte géographique fidedigne du Canton de Vaud"
      >
        <!-- 100% Geographically Accurate Closed-Loop Canton de Vaud Polygon (from OSM Relation 1702421) -->
        <path
          id="vaud-polygon"
          d="M 138.6,159.2 L 141.5,144.9 L 166.7,121.6 L 187.7,107.4 L 193.0,100.5 L 205.4,91.8 L 201.8,80.3 L 205.1,71.7 L 221.4,65.7 L 259.9,42.5 L 267.5,57.0 L 267.0,60.7 L 271.2,61.4 L 277.3,82.6 L 276.2,85.3 L 286.1,91.7 L 294.5,88.0 L 297.9,90.9 L 304.4,89.4 L 309.1,81.8 L 304.6,79.4 L 303.7,74.8 L 306.5,68.7 L 306.1,63.7 L 301.2,62.9 L 305.9,61.9 L 301.6,57.3 L 308.4,51.9 L 307.7,54.3 L 314.0,60.1 L 317.6,56.8 L 321.4,60.5 L 319.0,67.2 L 321.9,74.1 L 320.0,76.5 L 316.6,74.9 L 314.9,77.7 L 315.9,83.5 L 314.5,87.3 L 311.0,89.0 L 304.3,97.5 L 309.1,98.1 L 310.1,102.7 L 294.7,122.1 L 296.0,122.8 L 293.3,127.6 L 287.0,127.0 L 281.6,130.4 L 280.0,152.4 L 281.4,153.8 L 285.3,151.1 L 286.9,153.0 L 290.7,151.2 L 297.6,156.4 L 302.3,156.6 L 294.1,167.5 L 292.7,164.7 L 287.1,165.4 L 286.3,163.8 L 283.2,169.3 L 289.9,178.3 L 295.1,176.9 L 301.7,171.3 L 301.8,174.2 L 304.1,173.3 L 315.5,178.1 L 319.4,184.7 L 321.4,196.5 L 325.9,194.2 L 329.8,187.9 L 353.1,174.5 L 357.3,168.6 L 362.0,165.8 L 369.6,165.5 L 374.4,160.4 L 377.2,170.7 L 376.5,176.5 L 373.0,181.3 L 372.7,192.1 L 365.9,195.8 L 368.5,204.6 L 367.0,215.0 L 372.4,219.5 L 365.2,244.4 L 356.3,257.0 L 350.5,259.7 L 348.6,265.4 L 341.7,270.8 L 330.4,273.8 L 321.2,255.0 L 310.5,240.8 L 309.0,230.8 L 301.0,226.6 L 298.7,223.4 L 298.0,214.8 L 274.5,196.9 L 154.6,223.1 L 148.7,220.3 L 146.1,222.5 L 151.6,226.8 L 141.9,240.0 L 135.9,233.6 L 142.5,224.3 L 144.0,216.6 L 131.5,208.3 L 125.6,197.7 L 124.6,188.2 L 134.2,172.9 L 339.8,53.6 L 337.7,56.6 L 338.6,61.3 L 333.4,68.3 L 330.2,67.8 L 332.1,64.4 L 330.4,62.4 L 331.3,60.4 L 327.2,58.5 L 323.8,60.2 L 325.3,56.3 L 320.8,50.4 L 320.5,45.6 L 316.6,44.7 L 332.9,27.4 L 343.3,51.0 Z"
          fill="var(--accent)"
          fill-opacity="0.18"
          stroke="var(--accent)"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
      </svg>
    </div>
  </div>
</section>

<!-- Gorgeous glassmorphic options modal -->
<div id="booking-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
  <div class="modal-content">
    <button class="modal-close" aria-label="Fermer la fenêtre">&times;</button>
    <h2 id="modal-title">Diagnostic terrain gratuit</h2>
    <p class="modal-subtitle">Sélectionnez le moyen de contact le plus simple pour vous.</p>
    
    <div class="modal-options">
      <!-- Option 1: Google Calendar -->
      <a
        href={site.bookingHref}
        target={site.bookingIsConfigured ? "_blank" : undefined}
        rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
        class="modal-opt-card"
      >
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Réserver sur Google Calendar</h3>
          <p>Choisissez un créneau de 30 min en ligne</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 2: WhatsApp -->
      <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Écrire sur WhatsApp</h3>
          <p>Envoyez-moi un message direct et rapide</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 3: Call Directly -->
      <a href={site.phoneHref} class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Appeler directement</h3>
          <p>Parler de vive voix au {site.phone}</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>

      <!-- Option 4: Contact Form -->
      <a href="#contact" id="modal-opt-form" class="modal-opt-card">
        <div class="opt-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="opt-meta">
          <h3>Remplir le formulaire</h3>
          <p>Envoyer un message écrit en bas de page</p>
        </div>
        <span class="opt-arrow">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('hero-cta-trigger');
    const modal = document.getElementById('booking-modal');
    const closeBtn = modal?.querySelector('.modal-close');
    const formLink = document.getElementById('modal-opt-form');

    if (!trigger || !modal) return;

    // Open Modal
    trigger.addEventListener('click', () => {
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden'; // Prevent body scroll
    });

    const closeModal = () => {
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('is-open');
      document.body.style.overflow = ''; // Restore body scroll
    };

    // Close Modal
    closeBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Close when choosing contact form (scrolls to bottom)
    formLink?.addEventListener('click', () => {
      closeModal();
    });
  });
</script>
