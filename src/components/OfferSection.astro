---
import { site } from "@utils/seo";

const offers = [
  {
    title: "Diagnostic Terrain",
    price: "Gratuit",
    goal: "Discussion sur place ou par téléphone pour identifier où vous perdez plus de 2 heures par semaine.",
    details: [
      ["Format", "Sur place ou par téléphone"],
      ["Objectif", "Identifier les tâches répétitives qui vous font perdre du temps"],
      ["Durée", "30–60 minutes, sans engagement"],
    ],
    cta: "Demander mon diagnostic",
  },
  {
    title: "Le Micro-Automate",
    price: "CHF 450 (Fixe)",
    goal: "1 tâche automatisée en 48 heures. Zéro risque, validation rapide du concept.",
    details: [
      ["Délai", "48 heures maximum"],
      ["Bénéfice", "Zéro risque, preuve de concept immédiate"],
      ["Périmètre", "1 action ou transfert de données simple"],
    ],
    cta: "Lancer un micro-automate",
  },
  {
    title: "Le Pilote Opérationnel",
    price: "Dès CHF 950",
    goal: "Flux de travail complet étape par étape. Processus entièrement délégué à l’automatisation avec accompagnement de votre équipe.",
    details: [
      ["Périmètre", "Flux complet de bout en bout (multi-étapes)"],
      ["Accompagnement", "Mise en service et formation de votre équipe"],
      ["But", "Déléguer entièrement un processus administratif lourd"],
    ],
    cta: "Discuter d’un pilote",
  },
];
---

<section id="offres" class="offer-section" aria-labelledby="offer-title">
  <div class="container-shell">
    <header class="section-head">
      <p class="section-kicker">Commencer sans gros projet</p>
      <h2 id="offer-title" class="section-title">
        Des repères simples pour tester avant d’élargir.
      </h2>
      <p class="section-copy">
        Les prix ci-dessous sont des repères indicatifs. Le bon périmètre se
        décide après avoir vu votre processus réel et les outils déjà en place.
      </p>
    </header>

    <div class="offer-grid">
      {
        offers.map((offer) => (
          <article class="offer-card" data-reveal>
            <div>
              <p class="offer-price">{offer.price}</p>
              <h3>{offer.title}</h3>
              <p class="offer-goal">{offer.goal}</p>
            </div>
            <dl>
              {offer.details.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
            <a
              href={site.bookingHref}
              class="btn-secondary"
              target={site.bookingIsConfigured ? "_blank" : undefined}
              rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
            >
              {offer.cta}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
