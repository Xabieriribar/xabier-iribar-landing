---
// OfferSection.astro - Refactored Premium Pricing Cards Section
import { site } from "@utils/seo";
---

<section id="offres" class="offer-section" aria-labelledby="offer-title">
  <div class="container-shell">
    <header class="section-head">
      <p class="section-kicker kicker-with-bar">Commencer sans gros projet</p>
      <h2 id="offer-title" class="section-title">
        Des repères simples pour<br/>
        <span class="text-blue">tester</span> avant d’élargir.
      </h2>
      <p class="section-copy">
        Les prix ci-dessous sont des repères indicatifs. Le bon périmètre se décide après avoir vu votre processus réel et les outils déjà en place.
      </p>
    </header>

    <div class="offer-grid">
      <!-- CARD 1: DIAGNOSTIC TERRAIN (BLUE THEME) -->
      <article class="offer-card card-blue" data-reveal>
        <div class="card-top">
          <div class="offer-icon-circle">
            <!-- Compass SVG -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
            </svg>
          </div>
          <span class="price-badge">Gratuit</span>
        </div>

        <div class="card-middle-content">
          <h3>Diagnostic Terrain</h3>
          <p class="offer-goal">
            Discussion sur place ou par téléphone pour identifier où vous perdez plus de 2 heures par semaine.
          </p>
        </div>

        <!-- Details list grid -->
        <div class="offer-details-list">
          <div class="detail-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="detail-icon">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <div class="detail-text">
              <span class="detail-label">FORMAT</span>
              <span class="detail-val">Sur place ou par téléphone</span>
            </div>
          </div>

          <div class="detail-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="detail-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
            <div class="detail-text">
              <span class="detail-label">OBJECTIF</span>
              <span class="detail-val">Identifier les tâches répétitives qui vous font perdre du temps</span>
            </div>
          </div>

          <div class="detail-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="detail-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div class="detail-text">
              <span class="detail-label">DURÉE</span>
              <span class="detail-val">30–60 minutes, sans engagement</span>
            </div>
          </div>
        </div>

        <!-- Highlight strip -->
        <div class="reassurance-strip">
          <div class="check-circle-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <p class="reassurance-text">
            <strong>Clair et actionnable</strong><br/>
            <span>Repartez avec des pistes concrètes.</span>
          </p>
        </div>

        <a
          href={site.bookingHref}
          class="offer-cta-btn"
          target={site.bookingIsConfigured ? "_blank" : undefined}
          rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
        >
          <span>Demander mon diagnostic</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </article>

      <!-- CARD 2: LE MICRO-AUTOMATE (GREEN THEME) -->
      <article class="offer-card card-green" data-reveal>
        <div class="card-top">
          <div class="offer-icon-circle">
            <!-- Lightning SVG -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <span class="price-badge">CHF 450 (Fixe)</span>
        </div>

        <div class="card-middle-content">
          <h3>Le Micro-Automate</h3>
          <p class="offer-goal">
            1 tâche automatisée en 48 heures. Zéro risque, validation rapide du concept.
          </p>
        </div>

        <!-- Details list grid -->
        <div class="offer-details-list">
          <div class="detail-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="detail-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div class="detail-text">
              <span class="detail-label">DÉLAI</span>
              <span class="detail-val">48 heures maximum</span>
            </div>
          </div>

          <div class="detail-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="detail-icon">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <div class="detail-text">
              <span class="detail-label">BÉNÉFICE</span>
              <span class="detail-val">Zéro risque, preuve de concept immédiate</span>
            </div>
          </div>

          <div class="detail-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="detail-icon">
              <path d="M17 1v22M23 7l-6 6-6-6M13 17l-6-6-6 6"></path>
            </svg>
            <div class="detail-text">
              <span class="detail-label">PÉRIMÈTRE</span>
              <span class="detail-val">1 action ou transfert de données simple</span>
            </div>
          </div>
        </div>

        <!-- Highlight strip -->
        <div class="reassurance-strip">
          <div class="check-circle-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <p class="reassurance-text">
            <strong>Rapide et mesurable</strong><br/>
            <span>Un résultat concret en 2 jours.</span>
          </p>
        </div>

        <a
          href={site.bookingHref}
          class="offer-cta-btn"
          target={site.bookingIsConfigured ? "_blank" : undefined}
          rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
        >
          <span>Lancer un micro-automate</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </article>

      <!-- CARD 3: LE PILOTE OPÉRATIONNEL (PURPLE THEME) -->
      <article class="offer-card card-purple" data-reveal>
        <div class="card-top">
          <div class="offer-icon-circle">
            <!-- Layers / Stack Workflow SVG -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <span class="price-badge">Dès CHF 950</span>
        </div>

        <div class="card-middle-content">
          <h3>Le Pilote Opérationnel</h3>
          <p class="offer-goal">
            Flux de travail complet étape par étape. Processus entièrement délégué à l’automatisation avec accompagnement de votre équipe.
          </p>
        </div>

        <!-- Details list grid -->
        <div class="offer-details-list">
          <div class="detail-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="detail-icon">
              <rect x="9" y="9" width="6" height="6" rx="1"></rect>
              <rect x="2" y="16" width="6" height="6" rx="1"></rect>
              <rect x="16" y="16" width="6" height="6" rx="1"></rect>
              <path d="M12 15v3m0 0H5v-2m7 2h7-3"></path>
            </svg>
            <div class="detail-text">
              <span class="detail-label">PÉRIMÈTRE</span>
              <span class="detail-val">Flux complet de bout en bout (multi-étapes)</span>
            </div>
          </div>

          <div class="detail-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="detail-icon">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <div class="detail-text">
              <span class="detail-label">ACCOMPAGNEMENT</span>
              <span class="detail-val">Mise en service et formation de votre équipe</span>
            </div>
          </div>

          <div class="detail-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="detail-icon">
              <path d="M3 3v18h18M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"></path>
            </svg>
            <div class="detail-text">
              <span class="detail-label">BUT</span>
              <span class="detail-val">Déléguer entièrement un processus administratif lourd</span>
            </div>
          </div>
        </div>

        <!-- Highlight strip -->
        <div class="reassurance-strip">
          <div class="check-circle-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <p class="reassurance-text">
            <strong>Sérénité et performance</strong><br/>
            <span>On s'occupe du process, vous restez focus.</span>
          </p>
        </div>

        <a
          href={site.bookingHref}
          class="offer-cta-btn"
          target={site.bookingIsConfigured ? "_blank" : undefined}
          rel={site.bookingIsConfigured ? "noopener noreferrer" : undefined}
        >
          <span>Discuter d’un pilote</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </article>
    </div>

    <!-- BOTTOM PRICE TRUST FOOTER -->
    <footer class="offer-footer" data-reveal>
      <div class="footer-trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="offer-foot-icon">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7" y2="7"></line>
        </svg>
        <span>Tarifs indicatifs</span>
      </div>

      <div class="footer-trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="offer-foot-icon">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>Zéro engagement</span>
      </div>

      <div class="footer-trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="offer-foot-icon">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Résultats rapides</span>
      </div>

      <div class="footer-trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="offer-foot-icon">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
        </svg>
        <span>Accompagnement humain</span>
      </div>
    </footer>
  </div>
</section>

<style>
  /* Section settings */
  .offer-section {
    border-top: 1px solid var(--border);
    padding-block: 104px;
    background: radial-gradient(circle at 90% 10%, rgba(59, 130, 246, 0.02) 0%, transparent 40rem), var(--bg);
  }

  /* Subtitle kicker eyebrow */
  .kicker-with-bar {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }

  .kicker-with-bar::after {
    content: '';
    display: block;
    width: 16px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
    margin-left: 2px;
  }

  .text-blue {
    color: var(--accent);
  }

  /* Offers Cards Grid */
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 64px;
  }

  @media (max-width: 1100px) {
    .offer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .offer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  /* Core Card Layout */
  .offer-card {
    position: relative;
    background: var(--surface);
    border: 1px solid rgba(141, 169, 196, 0.25);
    border-radius: 20px;
    padding: 36px 28px;
    box-shadow: 0 10px 30px rgba(11, 37, 69, 0.02);
    display: flex;
    flex-direction: column;
    transition: 
      transform var(--motion-base) var(--ease-decelerate),
      box-shadow var(--motion-base) var(--ease-decelerate),
      border-color var(--motion-base) var(--ease-decelerate);
  }

  .offer-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 42px rgba(11, 37, 69, 0.05);
    border-color: var(--offer-accent);
  }

  /* Color themes per card */
  .card-blue {
    --offer-accent: #134074;
    --offer-accent-soft: rgba(19, 64, 116, 0.07);
  }

  .card-green {
    --offer-accent: #137333;
    --offer-accent-soft: rgba(19, 115, 51, 0.07);
  }

  .card-purple {
    --offer-accent: #681DA8;
    --offer-accent-soft: rgba(104, 29, 168, 0.07);
  }

  /* Top circle icon & price pill */
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .offer-icon-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--offer-accent-soft);
    color: var(--offer-accent);
  }

  .offer-icon-circle svg {
    width: 22px;
    height: 22px;
  }

  .price-badge {
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--offer-accent);
    background: var(--offer-accent-soft);
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: -0.01em;
  }

  /* Middle Text Area */
  .card-middle-content {
    margin-bottom: 28px;
  }

  .card-middle-content h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--fg);
    margin: 0 0 10px;
    line-height: 1.15;
  }

  .offer-goal {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
    font-weight: 600;
    margin: 0;
  }

  /* Details Grid rows */
  .offer-details-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid rgba(141, 169, 196, 0.16);
    padding-top: 24px;
    margin-bottom: 32px;
    flex-grow: 1;
  }

  .detail-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .detail-icon {
    width: 16px;
    height: 16px;
    color: var(--accent);
    opacity: 0.7;
    margin-top: 3px;
    flex-shrink: 0;
  }

  .detail-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .detail-label {
    font-size: 0.6rem;
    font-weight: 900;
    color: var(--border);
    letter-spacing: 0.05em;
  }

  .detail-val {
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--fg);
    font-weight: 700;
  }

  /* Bottom Reassurance Capsule */
  .reassurance-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--offer-accent-soft);
    border: 1px solid color-mix(in srgb, var(--offer-accent) 12%, var(--surface));
    border-radius: 12px;
    padding: 10px 14px;
    margin-bottom: 16px;
  }

  .check-circle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--offer-accent);
    flex-shrink: 0;
    box-shadow: 0 2px 5px rgba(11, 37, 69, 0.02);
  }

  .check-circle-icon svg {
    width: 10px;
    height: 10px;
  }

  .reassurance-text {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--fg);
  }

  .reassurance-text strong {
    font-weight: 800;
    color: var(--fg);
  }

  .reassurance-text span {
    color: var(--muted);
    font-weight: 600;
  }

  /* CTA Button Link */
  .offer-cta-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px 20px;
    background: var(--surface);
    border: 1px solid var(--offer-accent);
    border-radius: 12px;
    color: var(--offer-accent);
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none;
    transition: 
      background var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .offer-cta-btn:hover {
    background: var(--offer-accent);
    color: #FFFFFF;
  }

  .cta-arrow {
    width: 12px;
    height: 12px;
  }

  /* BOTTOM PRICE TRUST FOOTER */
  .offer-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 48px;
    margin-top: 64px;
    padding-top: 36px;
    border-top: 1px solid rgba(141, 169, 196, 0.16);
  }

  @media (max-width: 640px) {
    .offer-footer {
      gap: 20px;
      flex-direction: column;
      align-items: center;
    }
  }

  .footer-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .footer-trust-item:hover {
    color: var(--accent);
  }

  .offer-foot-icon {
    width: 16px;
    height: 16px;
    color: var(--border);
  }
</style>
