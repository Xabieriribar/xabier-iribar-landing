---
// AboutSection.astro - Refactored Premium "À Propos" Section matching the custom UI design
---

<section id="apropos" class="about-section" aria-labelledby="about-title">
  <div class="container-shell about-grid">
    <!-- LEFT SIDE: PORTRAIT WITH FLOATING CARDS -->
    <div class="portrait-container" data-reveal>
      <!-- Decorative Dot Grid Background -->
      <svg class="dots-bg" width="80" height="100" viewBox="0 0 80 100" fill="none" aria-hidden="true">
        <circle cx="10" cy="10" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="30" cy="10" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="50" cy="10" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="70" cy="10" r="2" fill="var(--cta)" opacity="0.35"/>
        
        <circle cx="10" cy="30" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="30" cy="30" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="50" cy="30" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="70" cy="30" r="2" fill="var(--cta)" opacity="0.35"/>
        
        <circle cx="10" cy="50" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="30" cy="50" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="50" cy="50" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="70" cy="50" r="2" fill="var(--cta)" opacity="0.35"/>
        
        <circle cx="10" cy="70" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="30" cy="70" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="50" cy="70" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="70" cy="70" r="2" fill="var(--cta)" opacity="0.35"/>

        <circle cx="10" cy="90" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle ccx="50" cy="90" r="2" fill="var(--cta)" opacity="0.35"/>
        <circle cx="70" cy="90" r="2" fill="var(--cta)" opacity="0.35"/>
      </svg>

      <!-- Main Portrait Frame -->
      <figure class="about-portrait">
        <img
          src="/assets/xabier-iribar-portrait.png"
          alt="Portrait de Xabier Iribar"
          width="1254"
          height="1254"
          loading="lazy"
        />
      </figure>


      <!-- Floating Card 2: Ma mission (Bottom Left) -->
      <div class="floating-card mission-card">
        <div class="mission-header">
          <div class="icon-wrap-lightning">
            <svg viewBox="0 0 24 24" fill="currentColor" class="lightning-icon">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <span class="mission-title">Ma mission</span>
        </div>
        <p class="mission-body">Simplifier votre quotidien avec des outils efficaces et sans jargon.</p>
      </div>

      <!-- Floating Badge: De Proximité (Bottom Right) -->
      <div class="badge-proximity">
        <svg viewBox="0 0 100 100" class="badge-text-svg">
          <path id="circlePath" d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="none" />
          <text font-size="6.5" font-weight="900" fill="#0F172A" font-family="var(--font-display)" letter-spacing="1.1">
            <textPath href="#circlePath">DE PROXIMITÉ • EN SUISSE • </textPath>
          </text>
        </svg>
        <div class="badge-center-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" class="pin-svg">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- RIGHT SIDE: TEXT & VALUE PROPOSITIONS GRID -->
    <div class="about-content" data-reveal>
      <header class="about-header">
        <p class="section-kicker kicker-with-bar">À propos</p>
        <h2 id="about-title" class="about-title">
          Qui se cache derrière vos <span class="text-blue">automations</span> ?
        </h2>
      </header>

      <div class="about-body">
        <p class="about-paragraph">
          Je m'appelle Xabier. Je vis et travaille dans la région lausannoise. Je ne suis pas une agence informatique qui veut révolutionner votre entreprise ou vous forcer à utiliser des logiciels compliqués.
        </p>
        <p class="about-paragraph">
          Je me vois plutôt comme un mécanicien du numérique : je viens avec ma boîte à outils pour connecter ce que vous utilisez déjà, éliminer les copier-coller inutiles, et vous permettre de <strong>rentrer chez vous à 17h</strong>.
        </p>
      </div>

      <!-- 2X2 Grid list of trust pillars -->
      <div class="about-trust-grid">
        <div class="trust-cell">
          <div class="trust-icon-container">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="trust-svg">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <p class="trust-label">
            Présent à Aclens<br/>
            Lausanne / Vaud
          </p>
        </div>

        <div class="trust-cell">
          <div class="trust-icon-container">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="trust-svg">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <p class="trust-label">
            Artisans, garages, ateliers,<br/>
            services techniques
          </p>
        </div>

        <div class="trust-cell">
          <div class="trust-icon-container">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="trust-svg">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <p class="trust-label">
            Français • English • Español<br/>
            Euskara • Deutsch
          </p>
        </div>

        <div class="trust-cell">
          <div class="trust-icon-container">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="trust-svg">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <p class="trust-label">
            Vos outils actuels d'abord,<br/>
            pas de jargon compliqué
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Base section spacing and border */
  .about-section {
    border-top: 1px solid var(--border);
    padding-block: 104px;
    background: radial-gradient(circle at 10% 90%, rgba(59, 130, 246, 0.03) 0%, transparent 40rem), var(--surface);
    overflow: hidden;
  }

  /* Core 2-Column Grid matching exactly */
  .about-grid {
    display: grid;
    grid-template-columns: 0.94fr 1.06fr;
    align-items: center;
    gap: 72px;
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  /* PORTRAIT WRAPPER WITH ABSOLUTE ELEMENTS */
  .portrait-container {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
    aspect-ratio: 1 / 1.05;
  }

  /* Dot Grid Background under top right */
  .dots-bg {
    position: absolute;
    top: -24px;
    right: -24px;
    z-index: 1;
    pointer-events: none;
  }

  /* Main Portrait Styling */
  .about-portrait {
    margin: 0;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    z-index: 2;
    box-shadow: 0 20px 48px rgba(13, 27, 42, 0.08);
    border: 1px solid rgba(119, 141, 169, 0.2);
    background: var(--surface);
  }

  .about-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    display: block;
  }

  /* FLOATING CARD BASE STYLES */
  .floating-card {
    position: absolute;
    z-index: 3;
    box-shadow: 0 12px 32px rgba(13, 27, 42, 0.08);
    border: 1px solid rgba(119, 141, 169, 0.16);
    transition: transform var(--motion-base) var(--ease-decelerate);
  }

  .floating-card:hover {
    transform: translateY(-3px);
  }

  /* Floating Card 1: À votre service (Top Left) */
  .status-card {
    top: 50px;
    left: -48px;
    width: 132px;
    background: var(--surface);
    border-radius: 18px;
    padding: 16px 14px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (max-width: 1200px) {
    .status-card {
      left: -20px;
    }
  }

  .icon-wrap-blue {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(13, 148, 136, 0.08);
    color: var(--accent);
    margin-bottom: 8px;
  }

  .card-icon {
    width: 15px;
    height: 15px;
  }

  .card-label {
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--muted);
    margin: 0 0 3px;
    letter-spacing: -0.01em;
  }

  .card-highlight {
    font-size: 1.6rem;
    font-weight: 900;
    font-family: var(--font-display);
    color: var(--accent);
    line-height: 1;
    margin: 2px 0 4px;
  }

  .card-subtext {
    font-size: 0.58rem;
    font-weight: 800;
    color: var(--muted);
    margin: 0;
  }

  /* Floating Card 2: Ma mission (Bottom Left) */
  .mission-card {
    bottom: -16px;
    left: -28px;
    width: 240px;
    background: #0D1B2A; /* Slate deep navy color */
    border-radius: 18px;
    padding: 18px 20px;
    color: #FFFFFF;
  }

  @media (max-width: 480px) {
    .mission-card {
      left: -10px;
      width: 220px;
    }
  }

  .mission-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .icon-wrap-lightning {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(13, 148, 136, 0.2);
    color: var(--cta);
    flex-shrink: 0;
  }

  .lightning-icon {
    width: 13px;
    height: 13px;
  }

  .mission-title {
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .mission-body {
    font-size: 0.76rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.88);
    font-weight: 600;
    margin: 0;
  }

  /* Floating Badge: De Proximité (Bottom Right) */
  .badge-proximity {
    position: absolute;
    bottom: -12px;
    right: -24px;
    width: 104px;
    height: 104px;
    background: var(--surface);
    border-radius: 50%;
    z-index: 3;
    box-shadow: 0 10px 24px rgba(13, 27, 42, 0.08);
    border: 1px solid rgba(119, 141, 169, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  @media (max-width: 1200px) {
    .badge-proximity {
      right: -10px;
    }
  }

  .badge-text-svg {
    width: 100%;
    height: 100%;
    position: absolute;
    animation: rotate-badge 20s linear infinite;
  }

  @keyframes rotate-badge {
    100% {
      transform: rotate(360deg);
    }
  }

  .badge-center-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(13, 148, 136, 0.1);
    color: var(--accent);
    z-index: 2;
  }

  .pin-svg {
    width: 14px;
    height: 14px;
  }

  /* RIGHT SIDE: CONTENT & VALUES */
  .about-content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .about-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Subtitle eyebrow with visual custom bar */
  .kicker-with-bar {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }

  .kicker-with-bar::after {
    content: '';
    display: block;
    width: 16px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
    margin-left: 2px;
  }

  .about-title {
    font-family: var(--font-display);
    font-size: 2.7rem;
    font-weight: 900;
    line-height: 1.1;
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .about-title {
      font-size: 2.1rem;
    }
  }

  .text-blue {
    color: var(--cta);
  }

  /* Body Paragraphs */
  .about-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-paragraph {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
    font-weight: 600;
  }

  .about-paragraph strong {
    color: var(--fg);
    font-weight: 800;
  }

  /* 2X2 Trust pillars layout */
  .about-trust-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    border-top: 1px solid rgba(119, 141, 169, 0.16);
    padding-top: 28px;
    margin-top: 8px;
  }

  @media (max-width: 600px) {
    .about-trust-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .trust-cell {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .trust-icon-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(13, 148, 136, 0.06);
    color: var(--accent);
    flex-shrink: 0;
    border: 1px solid rgba(13, 148, 136, 0.08);
  }

  .trust-svg {
    width: 18px;
    height: 18px;
  }

  .trust-label {
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--fg);
    font-weight: 800;
    margin: 0;
  }
</style>
