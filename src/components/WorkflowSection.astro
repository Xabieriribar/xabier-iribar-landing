---
const workflows = [
  {
    title: "Demande client → dossier clair",
    input: "Email, WhatsApp ou appel",
    transform: "Tri des informations utiles",
    validation: "Vous validez les points sensibles",
    output: "Résumé, informations manquantes, prochaine action"
  },
  {
    title: "Devis envoyé → relance prévue",
    input: "Devis sans réponse",
    transform: "Préparation du suivi",
    validation: "Vous choisissez le moment et le ton",
    output: "Relance prête à valider"
  },
  {
    title: "Note vocale → rapport",
    input: "Note terrain dictée",
    transform: "Structuration en langage clair",
    validation: "Vous corrigez avant partage",
    output: "Rapport propre pour le client ou l’équipe"
  },
  {
    title: "Documents → classement simple",
    input: "PDF, photos, emails",
    transform: "Extraction des éléments importants",
    validation: "Vous gardez le contrôle",
    output: "Informations extraites et rangées"
  }
];
---

<section class="section-pad border-y border-line bg-bone" aria-labelledby="workflow-title">
  <div class="container-shell">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow"><span class="red-dot" aria-hidden="true"></span> Exemples</p>
        <h2 id="workflow-title" class="section-title mt-4">
          Des exemples concrets, sans changer vos outils
        </h2>
      </div>
      <p class="section-copy">
        L’objectif est de simplifier une tâche réelle avec un processus lisible, pas de créer une plateforme complexe.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        workflows.map((workflow) => (
          <article class="rounded-lg border border-line bg-paper p-6">
            <h3 class="text-xl font-black text-ink">{workflow.title}</h3>
            <div class="mt-6 grid gap-3">
              <div class="grid gap-2 rounded-md border border-line bg-bone p-4 sm:grid-cols-[9rem_1fr]">
                <span class="text-xs font-black uppercase tracking-[0.14em] text-swiss-burgundy">Entrée</span>
                <span class="font-semibold text-coal">{workflow.input}</span>
              </div>
              <div class="mx-4 h-5 border-l border-swiss-red/45" aria-hidden="true"></div>
              <div class="grid gap-2 rounded-md border border-line bg-bone p-4 sm:grid-cols-[9rem_1fr]">
                <span class="text-xs font-black uppercase tracking-[0.14em] text-swiss-burgundy">
                  Transformation
                </span>
                <span class="font-semibold text-coal">{workflow.transform}</span>
              </div>
              <div class="mx-4 h-5 border-l border-swiss-red/45" aria-hidden="true"></div>
              <div class="grid gap-2 rounded-md border border-swiss-soft bg-white p-4 sm:grid-cols-[9rem_1fr]">
                <span class="text-xs font-black uppercase tracking-[0.14em] text-swiss-burgundy">
                  Validation humaine
                </span>
                <span class="font-semibold text-coal">{workflow.validation}</span>
              </div>
              <div class="mx-4 h-5 border-l border-swiss-red/45" aria-hidden="true"></div>
              <div class="grid gap-2 rounded-md bg-swiss-burgundy p-4 text-bone sm:grid-cols-[9rem_1fr]">
                <span class="text-xs font-black uppercase tracking-[0.14em] text-bone/80">Résultat</span>
                <span class="font-semibold">{workflow.output}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
