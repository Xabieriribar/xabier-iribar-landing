---
import { business } from "@config/business";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Accueil — Xabier Iribar">
      <span class="brand-mark" aria-hidden="true">XI</span>
      <span>
        <strong>{business.identity.name}</strong>
        <small>{business.identity.brandLine}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {business.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="button button-small header-cta" href="/audit/">
      {business.cta.primary}
    </a>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Navigation mobile">
        {
          business.navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
        <a href="/audit/">{business.cta.primary}</a>
      </nav>
    </details>
  </div>
</header>
