---
import { site } from "@utils/seo";

const navItems = [
  { href: "/#exemples", label: "Exemples" },
  { href: "/#methode", label: "Méthode" },
  { href: "/#offres", label: "Offres" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="site-header">
  <div class="container-shell header-inner">
    <a href="/" class="brand" aria-label="Accueil Xabier Iribar">
      <span class="brand-name">XABIER IRIBAR</span>
      <span class="brand-subtitle">{site.subtitle}</span>
    </a>

    <nav class="main-nav" aria-label="Navigation principale">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a
        href={site.phoneHref}
        class="phone-link"
        aria-label={`Appeler ${site.phone}`}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
        >
          <path
            d="M22 16.9v3a2 2 0 0 1-2.18 2 19.7 19.7 0 0 1-8.59-3.05 19.4 19.4 0 0 1-6-6A19.7 19.7 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.62a2 2 0 0 1-.45 2.11L8 9.7a16 16 0 0 0 6.3 6.3l1.25-1.27a2 2 0 0 1 2.11-.45c.84.29 1.72.5 2.62.62A2 2 0 0 1 22 16.9Z"
          ></path>
        </svg>
        {site.phone}
      </a>
      <a
        href="/#contact"
        class="btn-secondary"
      >
        Diagnostic gratuit
      </a>
    </div>
  </div>
</header>
