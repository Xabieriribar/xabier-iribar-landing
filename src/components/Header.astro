---
import { site } from "@utils/seo";

const navItems = [
  { href: "/#problemes", label: "Problèmes" },
  { href: "/#methode", label: "Méthode" },
  { href: "/#apropos", label: "À propos" },
  { href: "/#contact", label: "Contact" }
];
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/95 backdrop-blur-md">
  <div class="container-shell flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3 no-underline" aria-label="Accueil Xabier Iribar">
      <span class="flex size-10 items-center justify-center rounded-md bg-swiss-burgundy text-sm font-black text-bone shadow-sm">
        XI
      </span>
      <span class="leading-tight">
        <span class="block text-sm font-bold text-ink group-hover:text-swiss-burgundy">
          {site.name}
        </span>
        <span class="block text-xs font-semibold text-coal/65">
          {site.subtitle}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navigation principale">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-semibold text-coal/75 no-underline hover:text-swiss-burgundy"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/diagnostic" class="btn-primary hidden sm:inline-flex">
      Diagnostic gratuit
    </a>
  </div>
</header>
