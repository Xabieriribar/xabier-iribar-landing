---
// ContactSection.astro - Refactored Premium Swiss Style Contact Section
import { site } from "@utils/seo";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const formName = compact ? "diagnostic-qr" : "diagnostic-contact";
const HeadingTag = "h2";
const source = Astro.url.pathname;
const helpId = compact ? "contact-help-compact" : "contact-help";
---

<section
  id="contact"
  class:list={["contact-section", compact && "is-compact"]}
  aria-labelledby="contact-title"
>
  <div class="container-shell">
    <header class="section-head">
      <p class="section-kicker kicker-with-bar">Contact</p>
      <HeadingTag id="contact-title" class="section-title">
        {
          compact
            ? "Vous préférez écrire d’abord ?"
            : "Vous préférez expliquer votre situation par écrit ?"
        }
      </HeadingTag>
      <p id={helpId} class="section-copy">
        {
          compact
            ? "Expliquez en quelques lignes la tâche répétitive qui prend du temps à votre équipe. Je vous réponds pour voir si un diagnostic a du sens."
            : "Décrivez simplement la tâche administrative qui vous fait perdre du temps. Je vous réponds avec une première piste concrète."
        }
      </p>
    </header>

    <div class="contact-layout">
      <!-- LEFT SIDE: SECURE CONTACT FORM -->
      <div class="contact-card main-form-card" data-reveal>
        <div class="card-header-block">
          <h3>Envoyez-moi un message</h3>
          <p class="form-intro-text">Un premier contact simple, sécurisé et confidentiel.</p>
        </div>

        <form
          name={formName}
          method="POST"
          action="/api/contact"
          data-contact-form
          data-success-url="/merci"
          class="contact-form"
          aria-describedby={helpId}
        >
          <input type="hidden" name="form-name" value={formName} />
          <input type="hidden" name="source" value={source} />
          <input
            type="hidden"
            name="contact_started_at"
            value=""
            data-contact-started-at
          />
          <p class="hidden">
            <label>
              Ne pas remplir ce champ
              <input
                name="website"
                tabindex="-1"
                autocomplete="off"
                maxlength="200"
              />
            </label>
          </p>

          <div class="form-row">
            <label class="form-field">
              <span class="field-label">Prénom</span>
              <input
                class="field-control"
                name="prenom"
                autocomplete="given-name"
                placeholder="Jean"
                maxlength="80"
                required
              />
            </label>
            <label class="form-field">
              <span class="field-label">Nom</span>
              <input
                class="field-control"
                name="nom"
                autocomplete="family-name"
                placeholder="Dupont"
                maxlength="80"
                required
              />
            </label>
          </div>

          <div class="form-row">
            <label class="form-field">
              <span class="field-label">Entreprise</span>
              <input
                class="field-control"
                name="entreprise"
                autocomplete="organization"
                placeholder="Nom de l’entreprise"
                maxlength="120"
                required
              />
            </label>
            <label class="form-field">
              <span class="field-label">Téléphone</span>
              <input
                class="field-control"
                name="telephone"
                type="tel"
                autocomplete="tel"
                placeholder="Ex. +41 78 123 45 67"
                maxlength="30"
                required
              />
            </label>
          </div>

          <div class="form-row">
            <label class="form-field">
              <span class="field-label">Email</span>
              <input
                class="field-control"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="jean@entreprise.ch"
                maxlength="254"
                required
              />
            </label>
            <label class="form-field">
              <span class="field-label">Quelle tâche administrative vous énerve le plus ?</span>
              <div class="select-container">
                <select
                  class="field-control select-control"
                  name="tache_enerve"
                  required
                >
                  <option value="" disabled selected>Choisir une option...</option>
                  <option value="Générer et relancer les devis">Générer et relancer les devis</option>
                  <option value="Classer les photos et documents de chantiers / pannes">Classer les photos et documents de chantiers / pannes</option>
                  <option value="Saisir les rapports d'intervention ou heures d'employés">Saisir les rapports d'intervention ou heures d'employés</option>
                  <option value="Autre chose (gros bazar entre WhatsApp et Excel)">Autre chose (gros bazar entre WhatsApp et Excel)</option>
                </select>
                <div class="select-arrow">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </div>
              </div>
            </label>
          </div>

          <label class="form-field full-width">
            <span class="field-label">Message</span>
            <textarea
              class="field-control textarea-control"
              name="message"
              placeholder={compact
                ? "Quelle tâche vous prend du temps ?"
                : "Exemple : nous recevons les demandes par WhatsApp et e-mail, puis nous recopions tout dans Excel pour préparer les devis."}
              maxlength="3000"
              rows="4"
              required></textarea>
          </label>

          <p class="form-helper">
            Un exemple concret suffit: demande client, devis, relance, photos, dossier ou tableau Excel.
          </p>

          <button type="submit" class="submit-primary-btn">
            <span>Demander un diagnostic gratuit</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="btn-arrow">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 5"></polyline>
            </svg>
          </button>
          <p class="form-status" data-form-status aria-live="polite"></p>
        </form>

        <div class="privacy-note">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="privacy-lock"
          >
            <path d="M7 11V8a5 5 0 0 1 10 0v3"></path>
            <rect x="5" y="11" width="14" height="10" rx="2"></rect>
          </svg>
          <span>Données confidentielles. Réponse personnelle sous 24 h ouvrées.</span>
        </div>
      </div>

      <!-- RIGHT SIDE: DIRECT CONTACT CHANNELS -->
      <div class="contact-stack" data-reveal>
        <div class="contact-card methods-card">
          <h3>Autres moyens de me contacter</h3>

          <a class="contact-method" href={site.whatsappHref}>
            <div class="method-icon-circle whatsapp-theme">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="method-svg">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
            <div class="method-details">
              <strong class="method-title">WhatsApp</strong>
              <span class="method-sub">Réponse rapide</span>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="method-arrow">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 5"></polyline>
            </svg>
          </a>

          <a class="contact-method" href={site.phoneHref}>
            <div class="method-icon-circle phone-theme">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="method-svg">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="method-details">
              <strong class="method-title">Appeler</strong>
              <span class="method-sub">{site.phone}</span>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="method-arrow">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 5"></polyline>
            </svg>
          </a>

          <a class="contact-method" href={`mailto:${site.email}`}>
            <div class="method-icon-circle email-theme">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="method-svg">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="method-details">
              <strong class="method-title">Écrire un email</strong>
              <span class="method-sub">{site.email}</span>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="method-arrow">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 5"></polyline>
            </svg>
          </a>

          <a
            class="contact-method"
            href="https://maps.google.com/?q=Aclens%20Lausanne%20Vaud"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="method-icon-circle maps-theme">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="method-svg">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="method-details">
              <strong class="method-title">Basé à Aclens</strong>
              <span class="method-sub">Lausanne / Vaud</span>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="method-arrow">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 5"></polyline>
            </svg>
          </a>
        </div>

        <!-- Next Steps reassurance Box -->
        <div class="response-panel">
          <div class="response-icon-container">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="response-text-area">
            <h3>Ce qui se passe ensuite</h3>
            <p>
              Je vous réponds avec une première lecture: tâche pertinente,
              questions à clarifier et prochaine étape possible. Sans
              engagement.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Section settings */
  .contact-section {
    border-top: 1px solid var(--border);
    padding-block: 104px;
    background: var(--bg);
  }

  .contact-section.is-compact {
    padding-block: 72px;
  }

  /* Kicker subtitle with horizontal bar */
  .kicker-with-bar {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }

  .kicker-with-bar::after {
    content: '';
    display: block;
    width: 16px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
    margin-left: 2px;
  }

  /* Grid structure */
  .contact-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    margin-top: 56px;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* BASE CARD */
  .contact-card {
    background: var(--surface);
    border: 1px solid rgba(141, 169, 196, 0.25);
    border-radius: 20px;
    padding: 44px;
    box-shadow: 0 10px 30px rgba(11, 37, 69, 0.02);
  }

  @media (max-width: 640px) {
    .contact-card {
      padding: 28px 20px;
    }
  }

  .card-header-block {
    margin-bottom: 32px;
  }

  .card-header-block h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--fg);
    margin: 0 0 6px;
  }

  .form-intro-text {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
    margin: 0;
  }

  /* FORM STYLING */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .form-field.full-width {
    grid-column: span 2;
  }

  .field-label {
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--fg);
  }

  /* Inputs, select, textareas */
  .field-control {
    width: 100%;
    background: rgba(238, 244, 237, 0.35);
    border: 1px solid rgba(141, 169, 196, 0.35);
    border-radius: 12px;
    padding: 14px 18px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--fg);
    transition: 
      border-color var(--motion-fast) var(--ease-standard),
      background-color var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard);
  }

  .field-control::placeholder {
    color: var(--border);
    opacity: 0.8;
  }

  .field-control:hover {
    border-color: var(--border);
    background: rgba(238, 244, 237, 0.45);
  }

  .field-control:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--surface);
    box-shadow: 0 0 0 4px rgba(19, 64, 116, 0.08);
  }

  /* Custom dropdown styling */
  .select-container {
    position: relative;
    width: 100%;
  }

  .select-control {
    appearance: none;
    padding-right: 44px;
    cursor: pointer;
  }

  .select-arrow {
    position: absolute;
    top: 50%;
    right: 18px;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .select-arrow svg {
    width: 14px;
    height: 14px;
  }

  /* Textarea custom */
  .textarea-control {
    resize: vertical;
    min-height: 108px;
  }

  .form-helper {
    font-size: 0.72rem;
    color: var(--muted);
    font-weight: 600;
    margin: -4px 0 8px;
    line-height: 1.4;
  }

  /* Submit Button styling */
  .submit-primary-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--cta);
    border: 1px solid var(--cta);
    color: #FFFFFF;
    padding: 16px 24px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(19, 49, 92, 0.1);
    transition: 
      background var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard);
  }

  .submit-primary-btn:hover {
    background: var(--cta-dark);
    border-color: var(--cta-dark);
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(19, 49, 92, 0.16);
  }

  .submit-primary-btn:active {
    transform: translateY(0);
  }

  .btn-arrow {
    width: 14px;
    height: 14px;
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .submit-primary-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Privacy lock row */
  .privacy-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
  }

  .privacy-lock {
    width: 12px;
    height: 12px;
    color: var(--border);
    flex-shrink: 0;
  }

  /* RIGHT STACK COLUMN */
  .contact-stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .methods-card h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--fg);
    margin: 0 0 24px;
  }

  /* Direct channels links */
  .contact-method {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid rgba(141, 169, 196, 0.2);
    border-radius: 16px;
    text-decoration: none;
    color: var(--fg);
    transition: 
      transform var(--motion-base) var(--ease-decelerate),
      box-shadow var(--motion-base) var(--ease-decelerate),
      border-color var(--motion-base) var(--ease-decelerate);
  }

  .contact-method:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(11, 37, 69, 0.03);
    border-color: var(--accent);
  }

  .contact-method + .contact-method {
    margin-top: 12px;
  }

  /* Soft color-coded circles for icons */
  .method-icon-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid rgba(141, 169, 196, 0.12);
  }

  .whatsapp-theme {
    background: rgba(19, 115, 51, 0.05);
    color: #137333;
  }

  .phone-theme {
    background: rgba(19, 64, 116, 0.05);
    color: var(--accent);
  }

  .email-theme {
    background: rgba(104, 29, 168, 0.05);
    color: #681DA8;
  }

  .maps-theme {
    background: rgba(200, 108, 0, 0.05);
    color: #C86C00;
  }

  .method-svg {
    width: 16px;
    height: 16px;
  }

  .method-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
  }

  .method-title {
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--fg);
  }

  .method-sub {
    font-size: 0.74rem;
    color: var(--muted);
    font-weight: 600;
  }

  .method-arrow {
    width: 14px;
    height: 14px;
    color: var(--border);
    opacity: 0.5;
    transition: 
      transform var(--motion-fast) var(--ease-standard),
      opacity var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .contact-method:hover .method-arrow {
    opacity: 1;
    color: var(--accent);
    transform: translateX(4px);
  }

  /* Next steps box styling */
  .response-panel {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    background: var(--surface);
    border: 1px solid rgba(141, 169, 196, 0.2);
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 8px 24px rgba(11, 37, 69, 0.015);
  }

  .response-icon-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(19, 64, 116, 0.06);
    color: var(--accent);
    flex-shrink: 0;
    border: 1px solid rgba(19, 64, 116, 0.08);
  }

  .response-icon-container svg {
    width: 18px;
    height: 18px;
  }

  .response-text-area h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 900;
    color: var(--fg);
    margin: 0 0 8px;
  }

  .response-text-area p {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--muted);
    font-weight: 600;
    margin: 0;
  }
</style>
