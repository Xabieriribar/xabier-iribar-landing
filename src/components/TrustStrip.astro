---
const logos = [
  {
    name: "Oust",
    src: "/assets/generated/oust-card.png",
    href: "https://oust.ch/",
    width: 420,
    height: 190,
    className: "logo-oust",
  },
  {
    name: "Socraft",
    src: "/assets/generated/socraft-card.png",
    href: "https://socraft.io/",
    width: 420,
    height: 190,
    className: "logo-socraft",
  },
  {
    name: "42 Lausanne",
    src: "/assets/generated/42-lausanne-card.png",
    href: "https://42lausanne.ch/",
    width: 420,
    height: 190,
    className: "logo-42",
  },
  {
    name: "J42 Lausanne",
    src: "/assets/generated/j42-lausanne-card.png",
    href: "https://j42l.ch/",
    width: 420,
    height: 190,
    className: "logo-j42",
  },
];

const repeatedLogos = Array.from({ length: 3 }, (_, groupIndex) =>
  logos.map((logo) => ({ ...logo, decorative: groupIndex > 0 })),
).flat();
---

<section class="trust-strip" aria-labelledby="trust-title" data-reveal>
  <div class="container-shell">
    <div class="trust-heading">
      <h2 id="trust-title">Ils m’ont déjà fait confiance</h2>
      <p>Références, collaborations et environnement local.</p>
    </div>

    <p class="sr-only">Oust, Socraft, 42 Lausanne, J42 Lausanne.</p>
    <div class="logo-window">
      <div class="logo-track">
        {
          repeatedLogos.map((logo) => (
            <a
              class={`logo-card ${logo.className}`}
              href={logo.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={logo.decorative ? undefined : `Visiter le site de ${logo.name}`}
              aria-hidden={logo.decorative ? "true" : undefined}
              tabindex={logo.decorative ? "-1" : undefined}
            >
              <img
                src={logo.src}
                alt={logo.decorative ? "" : `Logo ${logo.name}`}
                width={logo.width}
                height={logo.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
