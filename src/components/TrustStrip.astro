---
const logos = [
  {
    name: "Oust",
    src: "/assets/oust-logo.jpg",
    width: 1200,
    height: 307,
    className: "logo-oust",
  },
  {
    name: "Socraft",
    src: "/assets/socraft-logo.png",
    width: 400,
    height: 94,
    className: "logo-socraft",
  },
  {
    name: "42 Lausanne",
    src: "/assets/42-lausanne-logo.jpg",
    width: 474,
    height: 282,
    className: "logo-square logo-42",
  },
  {
    name: "J42 Lausanne",
    src: "/assets/j42-lausanne-logo.jpg",
    width: 200,
    height: 200,
    className: "logo-square",
  },
];

const repeatedLogos = Array.from({ length: 3 }, () => logos).flat();
---

<section class="trust-strip" aria-labelledby="trust-title">
  <div class="container-shell">
    <div class="trust-heading">
      <h2 id="trust-title">Ils m’ont déjà fait confiance</h2>
      <p>Références, collaborations et environnement local.</p>
    </div>

    <p class="sr-only">Oust, Socraft, 42 Lausanne, J42 Lausanne.</p>
    <div class="logo-window" aria-hidden="true">
      <div class="logo-track">
        {
          repeatedLogos.map((logo) => (
            <figure class={`logo-card ${logo.className}`}>
              <img
                src={logo.src}
                alt=""
                width={logo.width}
                height={logo.height}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
