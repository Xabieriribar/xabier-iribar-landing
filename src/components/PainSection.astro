---
const pains = [
  {
    title: "Demandes clients dispersées",
    text: "Téléphone, WhatsApp, email, notes papier: l’information arrive partout."
  },
  {
    title: "Devis sans relance",
    text: "Un devis est envoyé, puis le suivi dépend de la mémoire ou d’un rappel manuel."
  },
  {
    title: "Documents difficiles à retrouver",
    text: "PDF, photos, emails et fichiers restent dispersés entre plusieurs outils."
  },
  {
    title: "Rapports faits à la main",
    text: "Les notes terrain deviennent des rapports seulement en fin de journée, souvent dans l’urgence."
  },
  {
    title: "Boîte mail saturée",
    text: "Les demandes importantes se mélangent avec l’administratif quotidien."
  },
  {
    title: "Suivi client fragile",
    text: "Une relance oubliée peut coûter une opportunité."
  }
];
---

<section id="problemes" class="section-pad bg-paper" aria-labelledby="pain-title">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="eyebrow"><span class="red-dot" aria-hidden="true"></span> Terrain</p>
      <h2 id="pain-title" class="section-title mt-4">
        Ce qui reste manuel dans beaucoup de PME
      </h2>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        pains.map((pain, index) => (
          <article class="soft-card">
            <div class="mb-5 flex size-10 items-center justify-center rounded-md bg-swiss-soft text-sm font-black text-swiss-burgundy">
              {String(index + 1).padStart(2, "0")}
            </div>
            <h3 class="text-lg font-black text-ink">{pain.title}</h3>
            <p class="mt-3 leading-7 text-coal/75">{pain.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
