---
const points = [
  "Aucune action automatique sans validation humaine.",
  "Données fictives ou anonymisées possibles.",
  "Pas besoin de changer tous vos outils.",
  "L’entreprise garde le contrôle.",
  "Confidentialité des documents et échanges.",
  "Pas de promesse magique: on teste sur une tâche précise."
];
---

<section class="section-pad border-y border-line bg-bone" aria-labelledby="privacy-title">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="eyebrow"><span class="red-dot" aria-hidden="true"></span> Cadre</p>
      <h2 id="privacy-title" class="section-title mt-4">
        Contrôle, confidentialité et validation humaine
      </h2>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        points.map((point) => (
          <article class="rounded-lg border border-line bg-paper p-5">
            <div class="mb-4 size-6 rounded-sm bg-swiss-red" aria-hidden="true"></div>
            <p class="font-bold leading-7 text-coal">{point}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
