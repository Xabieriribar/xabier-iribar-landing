---
const useCases = [
  {
    profile: "Garages & Carrosseries",
    problem: "Les photos WhatsApp de pièces usées se perdent dans l'ordinateur.",
    solutionTitle: "Photo-to-Dossier",
    solutionDesc: "La photo envoyée par le mécanicien se classe toute seule dans le dossier du client."
  },
  {
    profile: "Artisans & Bâtiment",
    problem: "Vous passez vos soirées à taper des devis après une journée de chantier.",
    solutionTitle: "Voice-to-Quote",
    solutionDesc: "Dictez vos notes sur WhatsApp en quittant le chantier ; un brouillon de devis Excel se génère automatiquement."
  },
  {
    profile: "Maintenance & Technique",
    problem: "Les devis envoyés par e-mail restent sans réponse et sont oubliés.",
    solutionTitle: "Relance Automatique",
    solutionDesc: "Votre système relance poliment le client après 7 jours pour valider l'intervention."
  }
];
---

<section
  id="exemples"
  class="use-cases-section"
  aria-labelledby="use-cases-title"
>
  <div class="container-shell">
    <header class="section-head">
      <p class="section-kicker">Profils & Solutions</p>
      <h2 id="use-cases-title" class="section-title">
        Des solutions adaptées à votre quotidien.
      </h2>
      <p class="section-copy">
        Pas besoin de changer vos habitudes ou d’adopter un logiciel compliqué. Nous automatisons les tâches répétitives sur vos outils actuels.
      </p>
    </header>

    <div class="use-case-grid">
      {
        useCases.map((item, index) => (
          <article class="use-case-card" data-reveal>
            <span class="case-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <p class="case-sector">{item.profile}</p>
            <h3>{item.solutionTitle}</h3>
            <dl>
              <div>
                <dt>Problème</dt>
                <dd>{item.problem}</dd>
              </div>
              <div>
                <dt>Solution</dt>
                <dd>{item.solutionDesc}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
  </div>
</section>
