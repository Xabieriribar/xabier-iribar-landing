---
// UseCasesSection.astro - Redesigned High Fidelity Segment Cards with Custom SVG Art
---

<section
  id="exemples"
  class="use-cases-section"
  aria-labelledby="use-cases-title"
>
  <div class="container-shell">
    <header class="section-head">
      <p class="section-kicker">Profils & Solutions</p>
      <h2 id="use-cases-title" class="section-title">
        Des solutions adaptées à votre <span class="text-highlight">quotidien.</span>
      </h2>
      <p class="section-copy">
        Pas besoin de changer vos habitudes ou d’adopter un logiciel compliqué. Nous automatisons les tâches répétitives sur vos outils actuels.
      </p>
    </header>

    <div class="use-case-grid">
      <!-- CARD 1: GARAGES & CARROSSERIES -->
      <article class="use-case-card card-blue" data-reveal>
        <div class="card-header">
          <span class="case-number">01</span>
          <p class="case-sector">Garages & Carrosseries</p>
        </div>

        <div class="card-title-block">
          <div class="title-icon-circle">
            <!-- Camera SVG -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
          </div>
          <div class="title-text-wrap">
            <h3>Photo-to-Dossier</h3>
            <div class="solution-flow">
              <span class="flow-step">+ Photo</span>
              <span class="flow-arrow">→</span>
              <span class="flow-step">WhatsApp</span>
              <span class="flow-arrow">→</span>
              <span class="flow-step">Dossier client</span>
            </div>
          </div>
        </div>

        <!-- Before & After Comparison Columns -->
        <div class="comparison-container">
          <!-- AVANT Column -->
          <div class="comp-column comp-before">
            <span class="comp-badge">AVANT</span>
            <ul class="comp-list">
              <li>
                <span class="bullet-x">✕</span>
                Photos WhatsApp perdues
              </li>
              <li>
                <span class="bullet-x">✕</span>
                Dossiers incomplets
              </li>
            </ul>
            
            <!-- AVANT Designed SVG Art -->
            <div class="wireframe-box before-visual-1">
              <svg viewBox="0 0 120 80" class="custom-svg-art" aria-hidden="true">
                <rect x="42" y="10" width="36" height="60" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <line x1="48" y1="16" x2="72" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="60" cy="40" r="10" fill="none" stroke="#EF4444" stroke-width="1.5" stroke-dasharray="3,3"/>
                <path d="M60 34v10M60 49h.01" stroke="#EF4444" stroke-width="2.5" stroke-linecap="round"/>
                <circle cx="95" cy="22" r="8" fill="#EF4444" fill-opacity="0.1" stroke="#EF4444" stroke-width="1"/>
                <path d="M92 19l6 6M98 19l-6 6" stroke="#EF4444" stroke-width="1.5"/>
              </svg>
            </div>
          </div>

          <!-- Floating Chevron Separator -->
          <div class="column-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>

          <!-- APRÈS Column -->
          <div class="comp-column comp-after">
            <span class="comp-badge">APRÈS</span>
            <ul class="comp-list">
              <li>
                <span class="bullet-check">✓</span>
                Classement automatique
              </li>
              <li>
                <span class="bullet-check">✓</span>
                Historique client propre
              </li>
            </ul>

            <!-- APRÈS Designed SVG Art -->
            <div class="wireframe-box after-visual-1">
              <svg viewBox="0 0 120 80" class="custom-svg-art" aria-hidden="true">
                <rect x="35" y="15" width="50" height="50" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <path d="M40 25h40M40 38h40M40 51h40" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="95" cy="22" r="8" fill="#10B981" fill-opacity="0.1" stroke="#10B981" stroke-width="1"/>
                <path d="M92 22l2 2 4-4" fill="none" stroke="#10B981" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M18 35l1 2 2 1-2 1-1 2-1-2-2-1 2-1z" fill="#10B981"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Bottom Benefit Strip -->
        <div class="card-benefit-strip">
          <div class="benefit-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <p class="benefit-text">
            <strong>Une photo envoyée = dossier mis à jour.</strong> 
            <span class="benefit-highlight">+30 min gagnées/jour</span>
          </p>
        </div>
      </article>

      <!-- CARD 2: ARTISANS & BÂTIMENT -->
      <article class="use-case-card card-green" data-reveal>
        <div class="card-header">
          <span class="case-number">02</span>
          <p class="case-sector">Artisans & Bâtiment</p>
        </div>

        <div class="card-title-block">
          <div class="title-icon-circle">
            <!-- Microphone SVG -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" y1="19" x2="12" y2="23"></line>
              <line x1="8" y1="23" x2="16" y2="23"></line>
            </svg>
          </div>
          <div class="title-text-wrap">
            <h3>Voice-to-Quote</h3>
            <div class="solution-flow">
              <span class="flow-step">Dictée vocale</span>
              <span class="flow-arrow">→</span>
              <span class="flow-step">Devis brouillon</span>
            </div>
          </div>
        </div>

        <!-- Before & After Comparison Columns -->
        <div class="comparison-container">
          <!-- AVANT Column -->
          <div class="comp-column comp-before">
            <span class="comp-badge">AVANT</span>
            <ul class="comp-list">
              <li>
                <span class="bullet-x">✕</span>
                Devis tapés le soir
              </li>
              <li>
                <span class="bullet-x">✕</span>
                Notes vocales oubliées
              </li>
            </ul>

            <!-- AVANT Designed SVG Art -->
            <div class="wireframe-box before-visual-2">
              <svg viewBox="0 0 120 80" class="custom-svg-art" aria-hidden="true">
                <rect x="42" y="18" width="36" height="44" rx="6" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <rect x="52" y="26" width="16" height="20" rx="8" fill="none" stroke="#EF4444" stroke-width="1.5"/>
                <path d="M47 36a13 13 0 0 0 26 0" fill="none" stroke="#EF4444" stroke-width="1.5"/>
                <line x1="60" y1="49" x2="60" y2="56" stroke="#EF4444" stroke-width="1.5"/>
                <line x1="25" y1="15" x2="95" y2="65" stroke="#EF4444" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
          </div>

          <!-- Floating Chevron Separator -->
          <div class="column-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>

          <!-- APRÈS Column -->
          <div class="comp-column comp-after">
            <span class="comp-badge">APRÈS</span>
            <ul class="comp-list">
              <li>
                <span class="bullet-check">✓</span>
                Brouillon généré
              </li>
              <li>
                <span class="bullet-check">✓</span>
                Gain de temps administratif
              </li>
            </ul>

            <!-- APRÈS Designed SVG Art -->
            <div class="wireframe-box after-visual-2">
              <svg viewBox="0 0 120 80" class="custom-svg-art" aria-hidden="true">
                <rect x="35" y="12" width="50" height="56" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <line x1="42" y1="20" x2="78" y2="20" stroke="currentColor" stroke-width="2"/>
                <line x1="42" y1="28" x2="78" y2="28" stroke="currentColor" stroke-width="1" stroke-dasharray="1,2"/>
                <line x1="42" y1="36" x2="78" y2="36" stroke="currentColor" stroke-width="1" stroke-dasharray="1,2"/>
                <rect x="42" y="44" width="36" height="12" rx="2" fill="#10B981" fill-opacity="0.1" stroke="#10B981" stroke-width="1"/>
                <path d="M48 50h3" stroke="#10B981" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M68 50h6" stroke="#10B981" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Bottom Benefit Strip -->
        <div class="card-benefit-strip">
          <div class="benefit-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <p class="benefit-text">
            <strong>Vous dictez. Le devis se prépare.</strong> 
            <span class="benefit-highlight">+45 min gagnées/jour</span>
          </p>
        </div>
      </article>

      <!-- CARD 3: MAINTENANCE & TECHNIQUE -->
      <article class="use-case-card card-purple" data-reveal>
        <div class="card-header">
          <span class="case-number">03</span>
          <p class="case-sector">Maintenance & Technique</p>
        </div>

        <div class="card-title-block">
          <div class="title-icon-circle">
            <!-- Refresh/loop SVG -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
          </div>
          <div class="title-text-wrap">
            <h3>Relance Automatique</h3>
            <div class="solution-flow">
              <span class="flow-step">Devis envoyé</span>
              <span class="flow-arrow">→</span>
              <span class="flow-step">7 jours</span>
              <span class="flow-arrow">→</span>
              <span class="flow-step">Relance</span>
            </div>
          </div>
        </div>

        <!-- Before & After Comparison Columns -->
        <div class="comparison-container">
          <!-- AVANT Column -->
          <div class="comp-column comp-before">
            <span class="comp-badge">AVANT</span>
            <ul class="comp-list">
              <li>
                <span class="bullet-x">✕</span>
                Devis sans réponse
              </li>
              <li>
                <span class="bullet-x">✕</span>
                Clients oubliés
              </li>
            </ul>

            <!-- AVANT Designed SVG Art -->
            <div class="wireframe-box before-visual-3">
              <svg viewBox="0 0 120 80" class="custom-svg-art" aria-hidden="true">
                <rect x="40" y="15" width="40" height="50" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <line x1="48" y1="25" x2="72" y2="25" stroke="currentColor" stroke-width="1"/>
                <line x1="48" y1="33" x2="72" y2="33" stroke="currentColor" stroke-width="1"/>
                <circle cx="60" cy="48" r="8" fill="none" stroke="#EF4444" stroke-width="1.5"/>
                <polyline points="60 44 60 48 64 48" fill="none" stroke="#EF4444" stroke-width="1.5"/>
                <circle cx="92" cy="22" r="8" fill="#EF4444" fill-opacity="0.1" stroke="#EF4444" stroke-width="1"/>
                <path d="M92 18v4M92 26h.01" stroke="#EF4444" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </div>
          </div>

          <!-- Floating Chevron Separator -->
          <div class="column-separator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>

          <!-- APRÈS Column -->
          <div class="comp-column comp-after">
            <span class="comp-badge">APRÈS</span>
            <ul class="comp-list">
              <li>
                <span class="bullet-check">✓</span>
                Relance après 7 jours
              </li>
              <li>
                <span class="bullet-check">✓</span>
                Plus d'interventions validées
              </li>
            </ul>

            <!-- APRÈS Designed SVG Art -->
            <div class="wireframe-box after-visual-3">
              <svg viewBox="0 0 120 80" class="custom-svg-art" aria-hidden="true">
                <rect x="35" y="25" width="40" height="40" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <line x1="42" y1="35" x2="68" y2="35" stroke="currentColor" stroke-width="1"/>
                <path d="M70 20l25-10-10 25-5-10-10-5z" fill="none" stroke="#10B981" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M55 45c10 0 15-10 20-15" fill="none" stroke="#10B981" stroke-width="1.2" stroke-dasharray="3,3"/>
                <path d="M96 36l1 1.5 1.5 1-1.5 1-1 1.5-1-1.5-1.5-1 1.5-1z" fill="#10B981"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Bottom Benefit Strip -->
        <div class="card-benefit-strip">
          <div class="benefit-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <p class="benefit-text">
            <strong>Le système relance pour vous.</strong> 
            <span class="benefit-highlight">+20% de devis validés</span>
          </p>
        </div>
      </article>
    </div>

    <!-- Bottom Section Trust Indicators -->
    <footer class="use-cases-footer">
      <div class="trust-indicator">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="trust-icon">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Sécurisé & confidentiel</span>
      </div>
      <div class="trust-indicator">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="trust-icon">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span>Compatible avec vos outils</span>
      </div>
      <div class="trust-indicator">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="trust-icon">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>Mise en place rapide</span>
      </div>
    </footer>
  </div>
</section>

<style>
  /* Section settings */
  .use-cases-section {
    border-top: 1px solid var(--border);
    padding-block: 92px 84px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.44) 100%);
  }

  .text-highlight {
    color: var(--accent);
    background: linear-gradient(120deg, var(--accent) 0%, var(--muted) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
  }

  /* Grid layout */
  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 56px;
  }

  @media (max-width: 1100px) {
    .use-case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .use-case-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* Card base */
  .use-case-card {
    --card-accent: var(--accent);
    --card-accent-soft: rgba(27, 38, 59, 0.08);
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px 24px;
    box-shadow: var(--motion-shadow);
    transition: 
      transform var(--motion-base) var(--ease-decelerate),
      box-shadow var(--motion-base) var(--ease-standard),
      border-color var(--motion-base) var(--ease-standard);
    overflow: hidden;
  }

  /* Dynamic color integrations respecting the palette */
  .card-blue {
    --card-accent: color-mix(in srgb, var(--accent) 64%, #0EA5E9);
    --card-accent-soft: color-mix(in srgb, var(--card-accent) 8%, var(--surface));
  }

  .card-green {
    --card-accent: color-mix(in srgb, var(--accent) 64%, #10B981);
    --card-accent-soft: color-mix(in srgb, var(--card-accent) 8%, var(--surface));
  }

  .card-purple {
    --card-accent: color-mix(in srgb, var(--accent) 64%, #8B5CF6);
    --card-accent-soft: color-mix(in srgb, var(--card-accent) 8%, var(--surface));
  }

  .use-case-card:hover {
    transform: var(--motion-lift);
    border-color: var(--card-accent);
    box-shadow: var(--motion-shadow-hover);
  }

  /* Card header */
  .card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .case-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--card-accent-soft);
    color: var(--card-accent);
    font-size: 0.74rem;
    font-weight: 800;
    font-family: var(--font-body);
  }

  .case-sector {
    margin: 0;
    color: var(--card-accent);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Title block */
  .card-title-block {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 24px;
  }

  .title-icon-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--card-accent-soft);
    color: var(--card-accent);
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(13, 27, 42, 0.015);
  }

  .title-icon-circle svg {
    width: 20px;
    height: 20px;
  }

  .title-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-grow: 1;
    min-width: 0;
  }

  .title-text-wrap h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--fg);
    line-height: 1.15;
  }

  /* solution flow line - CLEAN TEXT FLOW WITH NO ICONS */
  .solution-flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 800;
    margin-top: 4px;
  }

  .flow-step {
    display: inline-flex;
    align-items: center;
    background: rgba(119, 141, 169, 0.07);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid rgba(119, 141, 169, 0.12);
  }

  .flow-arrow {
    color: var(--accent);
    opacity: 0.8;
    font-weight: 900;
    font-size: 0.95rem;
    padding-inline: 1px;
  }

  /* Comparison grid container */
  .comparison-container {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 24px;
    flex-grow: 1;
  }

  @media (max-width: 480px) {
    .comparison-container {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  /* Columns */
  .comp-column {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    padding: 14px 12px;
    min-height: 195px;
  }

  .comp-before {
    background: color-mix(in srgb, #EF4444 3%, var(--surface));
    border: 1px solid color-mix(in srgb, #EF4444 8%, var(--surface));
  }

  .comp-after {
    background: color-mix(in srgb, #10B981 3%, var(--surface));
    border: 1px solid color-mix(in srgb, #10B981 8%, var(--surface));
  }

  .comp-badge {
    align-self: flex-start;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 2px 6px;
    border-radius: 4px;
    margin-bottom: 10px;
  }

  .comp-before .comp-badge {
    background: rgba(239, 68, 68, 0.08);
    color: #EF4444;
  }

  .comp-after .comp-badge {
    background: rgba(16, 185, 129, 0.08);
    color: #10B981;
  }

  .comp-list {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
