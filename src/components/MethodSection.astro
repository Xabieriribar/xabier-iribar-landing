---
// MethodSection.astro - Refactored Premium "Notre Approche" Method Section
---

<section id="methode" class="method-section" aria-labelledby="method-title">
  <div class="container-shell">
    <header class="section-head">
      <p class="section-kicker kicker-with-bar">Notre approche</p>
      <h2 id="method-title" class="section-title">
        Une méthode courte,<br/>
        testée avec vos <span class="text-blue">vrais cas.</span>
      </h2>
      <p class="section-copy">
        On part d’une tâche concrète, on clarifie le processus,<br/>
        puis on construit seulement ce qui aide vraiment votre équipe.
      </p>
    </header>

    <!-- STEPS CARDS ROW WITH DIVISION ARROWS -->
    <div class="steps-container">
      <!-- STEP 1: OBSERVATION TERRAIN -->
      <article class="step-card card-blue" data-reveal>
        <span class="step-badge">01</span>
        <div class="step-icon-container">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="step-svg">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <h3>Observation terrain</h3>
        <p class="step-description">
          On regarde comment la demande arrive, qui la traite, où l’information se perd et ce qui est recopié.
        </p>
        <div class="step-bullet-box">
          <ul class="step-bullets">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>WhatsApp</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>E-mails</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Excel / Fichiers</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Copier-coller</span>
            </li>
          </ul>
        </div>
      </article>

      <!-- Divider Arrow 1 -->
      <div class="step-divider">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 5"></polyline>
        </svg>
      </div>

      <!-- STEP 2: PROTOTYPE CIBLÉ -->
      <article class="step-card card-green" data-reveal>
        <span class="step-badge">02</span>
        <div class="step-icon-container">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="step-svg">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <h3>Prototype ciblé</h3>
        <p class="step-description">
          On choisit une seule tâche utile et on construit une première version simple, sans changer tous vos outils.
        </p>
        <div class="step-bullet-box">
          <ul class="step-bullets">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Une seule tâche prioritaire</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Solution simple et rapide</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Première version en 48h</span>
            </li>
          </ul>
        </div>
      </article>

      <!-- Divider Arrow 2 -->
      <div class="step-divider">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 5"></polyline>
        </svg>
      </div>

      <!-- STEP 3: TEST AVEC VOS CAS -->
      <article class="step-card card-purple" data-reveal>
        <span class="step-badge">03</span>
        <div class="step-icon-container">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="step-svg">
            <rect x="16" y="16" width="6" height="6" rx="1"></rect>
            <rect x="2" y="16" width="6" height="6" rx="1"></rect>
            <rect x="9" y="2" width="6" height="6" rx="1"></rect>
            <path d="M12 8v8M5 16v-5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v5"></path>
          </svg>
        </div>
        <h3>Test avec vos cas</h3>
        <p class="step-description">
          On teste avec vos vrais emails, documents ou scénarios pour voir ce qui marche et ce qui doit rester humain.
        </p>
        <div class="step-bullet-box">
          <ul class="step-bullets">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Cas réels</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Retours de l'équipe</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Ajustements rapides</span>
            </li>
          </ul>
        </div>
      </article>

      <!-- Divider Arrow 3 -->
      <div class="step-divider">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 5"></polyline>
        </svg>
      </div>

      <!-- STEP 4: AJUSTEMENT + SUPPORT -->
      <article class="step-card card-orange" data-reveal>
        <span class="step-badge">04</span>
        <div class="step-icon-container">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="step-svg">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <h3>Ajustement + support</h3>
        <p class="step-description">
          On ajuste, on documente le fonctionnement et on garde une solution légère que l’équipe peut utiliser.
        </p>
        <div class="step-bullet-box">
          <ul class="step-bullets">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Documentation simple</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Support humain</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-check">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Autonomie de l'équipe</span>
            </li>
          </ul>
        </div>
      </article>
    </div>

    <!-- BOTTOM HORIZONTAL BANNER OF FEATURES -->
    <footer class="method-banner" data-reveal>
      <div class="banner-item">
        <div class="banner-icon-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="banner-svg">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="banner-text">
          <strong>Pas de transformation lourde.</strong><br/>
          <span class="text-blue-light">On commence petit, sur un vrai besoin.</span>
        </div>
      </div>

      <div class="banner-item">
        <div class="banner-icon-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="banner-svg">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div class="banner-text">
          <strong>Résultats rapides</strong><br/>
          <span class="text-muted">Premiers bénéfices en quelques jours.</span>
        </div>
      </div>

      <div class="banner-item">
        <div class="banner-icon-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="banner-svg">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
        </div>
        <div class="banner-text">
          <strong>Zéro risque</strong><br/>
          <span class="text-muted">On avance étape par étape, vous gardez le contrôle.</span>
        </div>
      </div>

      <div class="banner-item">
        <div class="banner-icon-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="banner-svg">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <div class="banner-text">
          <strong>Humain avant tout</strong><br/>
          <span class="text-muted">Des outils au service de votre équipe.</span>
        </div>
      </div>
    </footer>
  </div>
</section>

<style>
  /* Section settings */
  .method-section {
    border-top: 1px solid var(--border);
    padding-block: 104px;
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
  }

  /* Subtitle eyebrow kicker */
  .kicker-with-bar {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }

  .kicker-with-bar::after {
    content: '';
    display: block;
    width: 16px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
    margin-left: 2px;
  }

  .text-blue {
    color: var(--accent);
  }

  /* Steps Row container */
  .steps-container {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 12px;
    margin-top: 64px;
  }

  @media (max-width: 1100px) {
    .steps-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    
    .step-divider {
      display: none !important;
    }
  }

  @media (max-width: 640px) {
    .steps-container {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* Core step card styles */
  .step-card {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 36px 24px 28px;
    box-shadow: var(--motion-shadow);
    transition: 
      transform var(--motion-base) var(--ease-decelerate), 
      box-shadow var(--motion-base) var(--ease-decelerate),
      border-color var(--motion-base) var(--ease-decelerate);
  }

  @media (max-width: 640px) {
    .step-card:not(:last-child)::after {
      content: '';
      position: absolute;
      bottom: -28px;
      left: 50%;
      transform: translateX(-50%);
      width: 2px;
      height: 18px;
      background: linear-gradient(180deg, var(--step-accent) 0%, transparent 100%);
      z-index: 2;
    }
  }

  .step-card:hover {
    transform: var(--motion-lift);
    box-shadow: var(--motion-shadow-hover);
    border-color: var(--step-accent);
  }

  /* Color-coded themes */
  .card-blue {
    --step-accent: #134074;
    --step-accent-soft: rgba(19, 64, 116, 0.08);
  }

  .card-green {
    --step-accent: #137333;
    --step-accent-soft: rgba(19, 115, 51, 0.08);
  }

  .card-purple {
    --step-accent: #681DA8;
    --step-accent-soft: rgba(104, 29, 168, 0.08);
  }

  .card-orange {
    --step-accent: #C86C00;
    --step-accent-soft: rgba(200, 108, 0, 0.08);
  }

  /* Step number badge */
  .step-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--step-accent-soft);
    color: var(--step-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 900;
    font-family: var(--font-body);
  }

  /* Icon container */
  .step-icon-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--step-accent-soft);
    color: var(--step-accent);
    margin: 12px auto 24px;
    box-shadow: inset 0 2px 6px rgba(11, 37, 69, 0.015);
  }

  .step-svg {
    width: 26px;
    height: 26px;
  }

  /* Titles and Texts inside card */
  .step-card h3 {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 800;
    color: var(--fg);
    text-align: center;
    margin: 0 0 12px;
  }

  .step-description {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
    font-weight: 600;
    text-align: center;
    margin: 0 0 24px;
    flex-grow: 1;
  }

  /* Bullet list inside box */
  .step-bullet-box {
    background: var(--step-accent-soft);
    border-radius: 12px;
    padding: 16px;
    border: 1px solid color-mix(in srgb, var(--step-accent) 12%, var(--surface));
  }

  .step-bullets {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .step-bullets li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--fg);
  }

  .bullet-check {
    width: 13px;
    height: 13px;
    color: var(--step-accent);
    flex-shrink: 0;
  }

  /* Divider arrow circles */
  .step-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid rgba(141, 169, 196, 0.25);
    color: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(11, 37, 69, 0.03);
    z-index: 5;
  }

  .step-divider svg {
    width: 14px;
    height: 14px;
  }

  /* BOTTOM BANNER GRID */
  .method-banner {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr 0.92fr 1.08fr;
    align-items: center;
    background: var(--surface);
    border: 1px solid rgba(141, 169, 196, 0.2);
    border-radius: 20px;
    padding: 24px;
    margin-top: 56px;
    box-shadow: 0 8px 24px rgba(11, 37, 69, 0.015);
  }

  @media (max-width: 1024px) {
    .method-banner {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      padding: 32px 24px;
    }
  }

  @media (max-width: 600px) {
    .method-banner {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .banner-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-inline: 18px;
    border-right: 1px solid rgba(141, 169, 196, 0.16);
  }

  .banner-item:last-child {
    border-right: none;
  }

  @media (max-width: 1024px) {
    .banner-item {
      border-right: none;
      padding-inline: 8px;
    }
  }

  .banner-icon-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.06);
    color: var(--accent);
    flex-shrink: 0;
  }

  .banner-svg {
    width: 16px;
    height: 16px;
  }

  .banner-text {
    font-size: 0.74rem;
    line-height: 1.35;
    color: var(--fg);
  }

  .banner-text strong {
    font-weight: 800;
    color: var(--fg);
  }

  .text-blue-light {
    color: var(--accent);
    font-weight: 700;
  }

  .text-muted {
    color: var(--muted);
    font-weight: 600;
  }
</style>
