---
import "../styles/global.css";
import { business, canonical } from "@config/business";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  analytics?: boolean;
}

const {
  title = business.site.defaultTitle,
  description = business.site.defaultDescription,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  ogImage = "/og/default.png",
  structuredData = [],
  analytics = true,
} = Astro.props;

const canonicalUrl = canonical(canonicalPath);
const ogImageUrl = canonical(ogImage);
const analyticsEnabled =
  analytics && Boolean(business.integrations.analyticsDomain.value);
const sharedSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": canonical("/#business"),
    name: business.identity.name,
    slogan: business.identity.brandLine,
    description: business.site.defaultDescription,
    url: business.site.url,
    telephone: business.contact.phone.value || undefined,
    email: business.contact.email.value || undefined,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Aclens",
      addressRegion: "Vaud",
      addressCountry: "CH",
    },
    areaServed: ["Lausanne", "Ouest lausannois", "Morges", "Gros-de-Vaud"],
    serviceType: [
      "Simplification de processus administratifs",
      "Digitalisation de petites entreprises",
      "Sites internet pour entreprises locales",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": canonical("/#xabier-iribar"),
    name: business.identity.name,
    jobTitle: business.identity.brandLine,
    url: business.site.url,
    sameAs: [business.socials.linkedin, business.socials.github],
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "42 Lausanne",
      url: "https://42lausanne.ch/",
    },
  },
];
const pageSchemas = Array.isArray(structuredData)
  ? structuredData
  : [structuredData];
const jsonLd = [...sharedSchemas, ...pageSchemas].filter(Boolean);
---

<!doctype html>
<html lang={business.site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#16324a" />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <meta name="geo.region" content="CH-VD" />
    <meta name="geo.placename" content="Aclens" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta
      property="og:site_name"
      content={`${business.identity.name} · ${business.identity.brandLine}`}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Xabier Iribar, le mécanicien du numérique à Aclens"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      jsonLd.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
    {
      analyticsEnabled && (
        <script
          is:inline
          defer
          data-domain={business.integrations.analyticsDomain.value}
          src="https://plausible.io/js/script.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
