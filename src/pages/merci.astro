---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { business } from "@config/business";
---

<BaseLayout
  title="Merci pour votre demande | Xabier Iribar"
  description="Confirmation de votre demande de diagnostic."
  canonicalPath="/merci/"
  noindex
  analytics={false}
>
  <Header />
  <main id="contenu" tabindex="-1" class="section">
    <section
      class="shell thanks-panel work-card"
      aria-labelledby="thanks-title"
    >
      <p class="status-tag">Demande transmise</p>
      <h1 id="thanks-title">
        Merci. La prochaine étape est une lecture humaine.
      </h1>
      <p>
        Votre demande a été envoyée au processeur configuré. Xabier la lira et
        vous répondra dès que son activité le permet.
      </p>
      <div class="button-row center-actions">
        <a class="button" href="/">Retour à l’accueil</a>
        {
          business.contact.phoneHref && (
            <a
              class="button button-secondary"
              href={business.contact.phoneHref}
            >
              Appeler
            </a>
          )
        }
      </div>
      <p>
        <small
          >Si vous n’avez pas volontairement envoyé de formulaire, vous pouvez
          fermer cette page.</small
        >
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
