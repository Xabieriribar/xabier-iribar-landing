---
import BaseLayout from "@layouts/BaseLayout.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import { site } from "@utils/seo";
---

<BaseLayout
  title="Merci | Xabier Iribar"
  description="Merci pour votre demande de diagnostic."
  canonicalPath="/merci"
  noindex
>
  <Header />
  <main class="thanks-page">
    <section class="section-pad">
      <div class="container-shell">
        <div class="thanks-panel">
          <p class="section-kicker">Demande reçue</p>
          <h1>Merci, votre message a bien été transmis.</h1>
          <p>
            Je vous réponds personnellement dès que possible. Vous pouvez aussi me joindre directement si le sujet est urgent.
          </p>
          <div class="thanks-actions">
            <a href={site.phoneHref} class="btn-secondary" aria-label={`Appeler ${site.phone}`}>
              Appeler
            </a>
            <a href={site.whatsappHref} class="btn-secondary" aria-label="Écrire sur WhatsApp">
              WhatsApp
            </a>
            <a href="/" class="btn-primary">Retour à l’accueil</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
