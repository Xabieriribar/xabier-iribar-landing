---
import BaseLayout from "@layouts/BaseLayout.astro";
import BookingSection from "@components/BookingSection.astro";
import ContactSection from "@components/ContactSection.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
---

<BaseLayout
  title="Réserver un audit IA gratuit à Lausanne/Vaud | Xabier Iribar"
  description="Choisissez un créneau pour un audit IA gratuit autour de vos emails, WhatsApp, Excel, devis et suivis."
  canonicalPath="/diagnostic"
>
  <Header />
  <main>
    <BookingSection compact />
    <ContactSection compact />
    <section class="return-section">
      <div class="container-shell">
        <a class="text-link" href="/">Retour à l’accueil</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
