---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactSection from "@components/ContactSection.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
---

<BaseLayout
  title="Diagnostic automatisation PME à Lausanne/Vaud | Xabier Iribar"
  description="Réservez un diagnostic gratuit pour identifier une tâche répétitive à automatiser dans votre PME à Lausanne, Vaud ou en Suisse romande."
  canonicalPath="/diagnostic"
>
  <Header />
  <main>
    <ContactSection compact />
    <section class="return-section">
      <div class="container-shell">
        <a class="text-link" href="/">Retour à l’accueil</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
