---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactSection from "@components/ContactSection.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
---

<BaseLayout
  title="Diagnostic gratuit | Xabier Iribar"
  description="Décrivez une tâche répétitive de votre PME autour de Lausanne/Vaud et demandez un diagnostic gratuit."
  canonicalPath="/diagnostic"
>
  <Header />
  <main>
    <ContactSection compact />
    <section class="return-section">
      <div class="container-shell">
        <a class="text-link" href="/">Retour à l’accueil</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
