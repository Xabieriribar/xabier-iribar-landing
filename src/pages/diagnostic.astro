---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactSection from "@components/ContactSection.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
---

<BaseLayout
  title="Demander mon diagnostic terrain gratuit | Xabier Iribar"
  description="Identifiez les tâches répétitives qui vous font perdre du temps au quotidien (e-mails, WhatsApp, Excel, devis, relances)."
  canonicalPath="/diagnostic"
>
  <Header />
  <main>
    <ContactSection compact />
    <section class="return-section">
      <div class="container-shell">
        <a class="text-link" href="/">Retour à l’accueil</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
