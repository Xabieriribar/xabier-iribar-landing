---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactSection from "@components/ContactSection.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
---

<BaseLayout
  title="Diagnostic terrain gratuit | Xabier Iribar"
  description="Décrivez une tâche répétitive de votre PME autour de Lausanne/Vaud et demandez un diagnostic terrain gratuit."
  canonicalPath="/diagnostic"
>
  <Header />
  <main>
    <ContactSection compact />
    <section class="bg-paper pb-14">
      <div class="container-shell">
        <a class="font-bold text-swiss-burgundy" href="/">
          Retour à l’accueil
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
