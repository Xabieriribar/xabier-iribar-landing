---
import AboutSection from "@components/AboutSection.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactSection from "@components/ContactSection.astro";
import FAQSection from "@components/FAQSection.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import MethodSection from "@components/MethodSection.astro";
import OfferSection from "@components/OfferSection.astro";
import ProblemsSection from "@components/ProblemsSection.astro";
import SegmentsSection from "@components/SegmentsSection.astro";
import TrustStrip from "@components/TrustStrip.astro";
import UseCasesSection from "@components/UseCasesSection.astro";
---

<BaseLayout canonicalPath="/">
  <Header />
  <main>
    <Hero />
    <TrustStrip />
    <SegmentsSection />
    <ProblemsSection />
    <UseCasesSection />
    <MethodSection />
    <OfferSection />
    <AboutSection />
    <FAQSection />
    <ContactSection />
  </main>
  <Footer />
</BaseLayout>
