---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ContactDock from "@components/ContactDock.astro";
import FinalCta from "@components/FinalCta.astro";
import WorkOrderGraphic from "@components/WorkOrderGraphic.astro";
import { business } from "@config/business";

const faqs = [
  {
    question: "Faut-il remplacer nos outils actuels ?",
    answer:
      "Pas par principe. Le diagnostic commence avec ce que vous utilisez déjà. Un tableur mieux structuré, un formulaire plus court ou une règle de suivi peuvent suffire. Un nouvel outil n’est proposé que s’il simplifie réellement le travail.",
  },
  {
    question: "Est-ce forcément de l’automatisation ou de l’IA ?",
    answer:
      "Non. Une procédure plus claire ou un seul endroit pour saisir l’information peut être la meilleure réponse. L’IA n’est envisagée que pour une tâche compréhensible, par exemple préparer un brouillon de rapport qui reste relu par une personne.",
  },
  {
    question: "À qui appartiennent les comptes et les données ?",
    answer:
      "Les comptes de production et le domaine doivent appartenir au client autant que possible. Les accès, exports et dépendances sont documentés. Les services externes restent toutefois soumis à leurs propres conditions et lieux de traitement.",
  },
  {
    question: "La maintenance est-elle obligatoire ?",
    answer:
      "Non. La correction des défauts pendant la période convenue fait partie de la livraison. Le contenu, les changements de services tiers, les nouvelles fonctions et le support ultérieur sont séparés et chiffrés si vous en avez besoin.",
  },
  {
    question: "Pouvez-vous tout automatiser ?",
    answer:
      "Non, et ce n’est pas l’objectif. Les décisions qui ont un impact important restent validées par une personne. Un projet peut être refusé si le risque, la sensibilité des données ou la dépendance technique demande une équipe plus large.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<BaseLayout
  canonicalPath="/"
  title="Digitalisation pratique pour garages et artisans à Lausanne | Xabier Iribar"
  description="Xabier Iribar observe un flux concret, propose une intervention bornée et installe des outils maintenables pour les garages, artisans et ateliers vaudois."
  structuredData={faqSchema}
>
  <Header />
  <main id="contenu" tabindex="-1">
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Aclens · Lausanne et région</p>
          <h1>
            Le mécanicien du numérique pour les <span
              >petites entreprises vaudoises.</span
            >
          </h1>
          <p class="lead">
            J’observe un problème concret — appels manqués, photos dispersées,
            devis recopiés — puis j’installe une amélioration bornée, testée et
            documentée pour les garages, artisans et ateliers.
          </p>
          <div class="hero-actions">
            <a class="button" href="/audit/">{business.cta.primary}</a>
            <a class="text-link" href="#exemples">Voir des exemples</a>
          </div>
          <ul class="reassurance-list" aria-label="Repères de confiance">
            <li>Intervention locale</li>
            <li>Périmètre écrit</li>
            <li>Comptes au nom du client</li>
          </ul>
        </div>
        <div class="hero-visual">
          <WorkOrderGraphic />
        </div>
      </div>
    </section>

    <div class="trust-band">
      <ul class="shell">
        <li>Un problème à la fois</li>
        <li>Prix indicatif visible</li>
        <li>Documentation remise</li>
        <li>Maintenance facultative</li>
      </ul>
    </div>

    <section class="section" aria-labelledby="problems-title">
      <div class="shell">
        <header class="section-head">
          <p class="eyebrow">Le problème n’est pas « le numérique »</p>
          <h2 id="problems-title">
            C’est le travail qui se disperse pendant que le métier continue.
          </h2>
          <p class="lead">
            Le téléphone sonne pendant une intervention. La demande arrive aussi
            par WhatsApp. Puis quelqu’un doit remettre les morceaux ensemble le
            soir.
          </p>
        </header>
        <div class="grid-4">
          <article class="problem-card work-card">
            <span class="card-number">01</span>
            <h3>Demandes incomplètes</h3>
            <p>
              Un nom dans le téléphone, une photo dans WhatsApp et les détails
              dans un e-mail séparé.
            </p>
          </article>
          <article class="problem-card work-card">
            <span class="card-number">02</span>
            <h3>Informations recopiées</h3>
            <p>
              Les mêmes coordonnées passent du carnet au tableur, puis du
              tableur au devis.
            </p>
          </article>
          <article class="problem-card work-card">
            <span class="card-number">03</span>
            <h3>Suivi fragile</h3>
            <p>
              Les rendez-vous sont notés à plusieurs endroits et les relances
              reposent sur la mémoire.
            </p>
          </article>
          <article class="problem-card work-card">
            <span class="card-number">04</span>
            <h3>Dossiers incomplets</h3>
            <p>
              Photos, heures et rapport d’intervention n’arrivent pas ensemble
              dans le bon dossier.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section
      id="exemples"
      class="section section-white"
      aria-labelledby="examples-title"
    >
      <div class="shell">
        <header class="section-head">
          <p class="eyebrow">Exemples de flux possibles</p>
          <h2 id="examples-title">
            Des améliorations compréhensibles, avec une personne dans la boucle.
          </h2>
          <p>
            Ces exemples illustrent des usages à étudier. Ils ne sont ni des cas
            clients ni des promesses de résultat.
          </p>
        </header>
        <div class="grid-3">
          <article class="example-card work-card">
            <p class="status-tag">Garage · demande entrante</p>
            <h3>Un appel manqué devient une demande à rappeler.</h3>
            <div class="example-flow">
              <span>Appel ou formulaire</span><span
                >→ Fiche avec véhicule et motif</span
              ><span>→ File de rappel</span>
            </div>
            <p class="human-check">
              L’équipe confirme le rendez-vous et la priorité.
            </p>
          </article>
          <article class="example-card work-card">
            <p class="status-tag">Carrosserie · photos</p>
            <h3>Les photos rejoignent le bon dossier.</h3>
            <div class="example-flow">
              <span>Référence du dossier</span><span>→ Ajout des photos</span
              ><span>→ Contrôle des pièces manquantes</span>
            </div>
            <p class="human-check">
              Une personne vérifie le classement avant envoi.
            </p>
          </article>
          <article class="example-card work-card">
            <p class="status-tag">Artisan · rapport</p>
            <h3>Une note vocale prépare le rapport d’intervention.</h3>
            <div class="example-flow">
              <span>Note dictée</span><span>→ Brouillon structuré</span><span
                >→ Rapport prêt à relire</span
              >
            </div>
            <p class="human-check">
              Le technicien corrige et valide le document.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="offers-title">
      <div class="shell">
        <header class="section-head">
          <p class="eyebrow">Une progression adaptée à un indépendant</p>
          <h2 id="offers-title">
            Comprendre, vérifier, puis installer seulement ce qui est utile.
          </h2>
        </header>
        <div class="grid-4">
          {
            business.offers.slice(0, 4).map((offer, index) => (
              <article class="offer-summary-card work-card">
                <span class="card-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="status-tag">{offer.eyebrow}</p>
                <h3>{offer.name}</h3>
                <p>{offer.summary}</p>
                <p class="price">{offer.price.value}</p>
                {offer.price.needsOwnerReview && (
                  <span class="review-badge">Tarif à confirmer</span>
                )}
              </article>
            ))
          }
        </div>
        <p class="offer-note">
          Les montants sont des repères de qualification. Un prix ferme n’est
          proposé qu’après un cadrage écrit des accès, dépendances, exclusions
          et responsabilités.
        </p>
        <p>
          <a class="text-link" href="/offres/"
            >Voir les offres et leurs limites →</a
          >
        </p>
      </div>
    </section>

    <section class="section section-dark" aria-labelledby="diagnostic-title">
      <div class="shell">
        <header class="section-head">
          <p class="eyebrow">Le diagnostic initial</p>
          <h2 id="diagnostic-title">
            Apportez une situation réelle, pas un cahier des charges.
          </h2>
          <p>{business.diagnostic.format}</p>
        </header>
        <div class="grid-3 process-list">
          <article class="process-step work-card">
            <h3>Vous racontez</h3>
            <p>
              Qui reçoit l’information, où elle est notée et ce qui est souvent
              oublié.
            </p>
          </article>
          <article class="process-step work-card">
            <h3>Je cherche la friction</h3>
            <p>
              Je distingue le problème d’outil, de procédure, de donnée ou de
              responsabilité.
            </p>
          </article>
          <article class="process-step work-card">
            <h3>Nous décidons de la suite</h3>
            <p>{business.diagnostic.deliverable}</p>
          </article>
        </div>
        <div class="button-row section-actions">
          <a class="button" href="/audit/">{business.cta.primary}</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="principles-title">
      <div class="shell">
        <header class="section-head">
          <p class="eyebrow">Livraison directe par Xabier</p>
          <h2 id="principles-title">
            Pas de boîte noire, pas de dépendance organisée.
          </h2>
        </header>
        <div class="grid-3">
          <article class="principle-card work-card">
            <h3>Comptes au client</h3><p>
              Le domaine, les accès et les outils de production restent autant
              que possible sous votre contrôle.
            </p>
          </article>
          <article class="principle-card work-card">
            <h3>Tests par étapes</h3><p>
              On vérifie d’abord avec des exemples contrôlés et une procédure
              manuelle de secours.
            </p>
          </article>
          <article class="principle-card work-card">
            <h3>Transmission écrite</h3><p>
              Vous recevez les consignes, les dépendances et les informations de
              reprise utiles.
            </p>
          </article>
        </div>
        <p class="section-actions">
          <a class="text-link" href="/methode/">Lire la méthode complète →</a>
        </p>
      </div>
    </section>

    <section class="section section-white" aria-labelledby="credibility-title">
      <div class="shell about-snapshot">
        <div>
          <p class="eyebrow">Une personne, un interlocuteur</p>
          <h2 id="credibility-title">
            Une formation logicielle, appliquée au terrain.
          </h2>
        </div>
        <div class="about-copy">
          <p class="lead">
            Xabier s’est formé au développement logiciel à 42 Lausanne. Cette
            mention décrit une formation ; elle n’implique ni partenariat ni
            recommandation de l’école.
          </p>
          <p>
            Le site que vous consultez suit la même logique que l’offre :
            fichiers statiques, pages rapides, contenu structuré, comptes
            transférables et peu de JavaScript.
          </p>
          <p>
            <a class="text-link" href="/a-propos/"
              >En savoir plus sur Xabier →</a
            >
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <div class="shell narrow">
        <header class="section-head">
          <p class="eyebrow">Questions fréquentes</p>
          <h2 id="faq-title">Les limites font partie de l’intervention.</h2>
        </header>
        <div class="faq-list">
          {
            faqs.map((faq) => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <FinalCta />
  </main>
  <Footer />
  <ContactDock />
</BaseLayout>
