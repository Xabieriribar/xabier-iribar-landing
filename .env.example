# Identité et politique à confirmer avant publication commerciale/collecte.
PUBLIC_LEGAL_NAME=""
PUBLIC_BUSINESS_REGISTRATION=""
PUBLIC_POSTAL_ADDRESS=""
PUBLIC_PRIVACY_RETENTION=""

# Chemin public ou URL du portrait validé. Le fichier fourni dans le dépôt est
